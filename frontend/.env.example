# Public App Store product URL (https://apps.apple.com/...). Leave empty for honest “Coming to the App Store” CTAs.
PUBLIC_APP_STORE_URL=

# Cloudflare / Wrangler — YOUR account only. Run `pnpm exec wrangler whoami` before deploy.
# https://developers.cloudflare.com/workers/wrangler/system-environment-variables/
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
