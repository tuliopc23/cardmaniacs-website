---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MotionInit from '../../components/MotionInit.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — Cardmaniacs Blog`}>
  <Header currentPage="blog" />
  
  <main data-testid="blog-post-page">
    <article class="pt-32 pb-20 md:pt-40 md:pb-28">
      <div class="mx-auto max-w-[720px] px-6">
        
        <!-- Article header -->
        <header class="mb-12">
          <a href="/blog" class="inline-flex items-center gap-1 text-accent text-[13px] font-medium mb-8 hover:underline" data-testid="blog-back-link">
            <svg class="w-3.5 h-3.5 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
            All posts
          </a>
          
          {post.data.date && (
            <time class="text-ink-tertiary text-[13px] font-medium tracking-wide uppercase block mb-4" datetime={post.data.date}>
              {new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </time>
          )}

          <h1 class="heading-hero text-ink mb-5" data-testid="blog-post-title">{post.data.title}</h1>
          
          {post.data.summary && (
            <p class="body-large text-ink-secondary">{post.data.summary}</p>
          )}
        </header>

        <!-- Article content -->
        <div class="prose" data-testid="blog-post-content">
          <Content />
        </div>

      </div>
    </article>
  </main>

  <Footer />
  <MotionInit />
</Layout>

<style>
  /* Prose styling for article content */
  .prose {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink);
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
    color: var(--color-ink-secondary);
  }

  .prose :global(ul), .prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
    color: var(--color-ink-secondary);
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-surface-raised);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-border);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-ink-tertiary);
    font-style: italic;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border-light);
    margin: 2.5rem 0;
  }
</style>
