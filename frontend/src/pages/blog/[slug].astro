---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Container from '../../components/Container.astro';
import Prose from '../../components/ui/Prose.astro';
import MarketingReaderSurface from '../../components/marketing/MarketingReaderSurface.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import { getCollection, render } from 'astro:content';

/** Static HTML at build for content routes under `output: "server"`. */
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — Cardmaniacs Blog`}>
  <SiteNav currentPage="blog" />

  <main id="main-content">
    <article class="pt-16 pb-20 md:pt-40 md:pb-28">
      <Container narrow>
        <a href="/blog" class="inline-flex items-center gap-1.5 ink-accent text-[13px] font-display font-medium mb-8 hover:underline underline-offset-2">
          <LucideIcon name="arrow-left" size={14} class="-translate-y-px" />
          All posts
        </a>

        <MarketingReaderSurface
          title={post.data.title}
          source="Cardmaniacs Blog"
          meta={post.data.date
            ? new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
            : undefined}
          tags={['Blog', 'Reading desk']}
        >
          {post.data.summary && <p class="text-[1.125rem] ink-secondary mb-6">{post.data.summary}</p>}
          <Prose>
            <Content />
          </Prose>
        </MarketingReaderSurface>
      </Container>
    </article>
  </main>

  <SiteFooter />
</Layout>
