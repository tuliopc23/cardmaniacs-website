---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Container from '../../components/Container.astro';
import PostCard from '../../components/PostCard.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });

const featured = sortedPosts.find((p) => p.data.featured);
const rest = featured ? sortedPosts.filter((p) => p.id !== featured.id) : sortedPosts;
---

<Layout title="Blog — Cardmaniacs">
  <SiteNav currentPage="blog" />

  <main id="main-content">
    <section class="pt-16 pb-14 md:pt-40 md:pb-18">
      <Container>
        <PageHero
          eyebrow="Notes from the reading desk"
          eyebrowIcon="notebook-pen"
          title="Calm thoughts on reading, craft, and native software."
          lede="Updates, thoughts, and stories about building a calm reading experience for Apple platforms."
          maxWidth="760px"
        />
      </Container>
    </section>

    <section class="pb-24">
      <Container>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 justify-items-center">
          {featured && (
            <PostCard
              href={`/blog/${featured.id}`}
              title={featured.data.title}
              summary={featured.data.summary}
              date={featured.data.date}
              cover={featured.data.cover}
              featured
              tags={featured.data.tags}
            />
          )}

          {rest.map((post) => (
            <PostCard
              href={`/blog/${post.id}`}
              title={post.data.title}
              summary={post.data.summary}
              date={post.data.date}
              cover={post.data.cover}
              tags={post.data.tags}
            />
          ))}
        </div>
      </Container>
    </section>
  </main>

  <SiteFooter />
</Layout>
