---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MotionInit from '../../components/MotionInit.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});
---

<Layout title="Blog — Cardmaniacs">
  <Header currentPage="blog" />
  
  <main data-testid="blog-page">
    
    <!-- Blog hero -->
    <section class="pt-32 pb-16 md:pt-40 md:pb-20 relative overflow-hidden">
      <div class="blob blob-mint w-[400px] h-[400px] -top-32 -right-24 absolute"></div>
      <div class="mx-auto max-w-[1120px] px-6 relative">
        <div class="max-w-[680px]">
          <p class="label text-accent mb-5">Blog</p>
          <h1 class="heading-hero text-ink mb-6">
            Notes from<br/>the reading desk.
          </h1>
          <p class="body-large text-ink-secondary max-w-[520px]">
            Updates, thoughts, and stories about building a calm reading experience for Apple platforms.
          </p>
        </div>
      </div>
    </section>

    <!-- Blog grid -->
    <section class="pb-20">
      <div class="mx-auto max-w-[1120px] px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="blog-grid" data-reveal-group>
          {sortedPosts.map((post) => (
            <a 
              href={`/blog/${post.id}`}
              class="group block bg-surface-raised rounded-xl overflow-hidden border border-border-light hover:shadow-card-hover transition-all duration-300 hover:-translate-y-0.5"
              data-testid={`blog-card-${post.id}`}
            >
              <!-- Paper-like article card surface -->
              <div class="p-7">
                {post.data.date && (
                  <time class="text-ink-tertiary text-[12px] font-medium tracking-wide uppercase" datetime={post.data.date}>
                    {new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                  </time>
                )}
                <h2 class="heading-subsection text-ink mt-2.5 mb-3 group-hover:text-accent transition-colors duration-200">
                  {post.data.title}
                </h2>
                {post.data.summary && (
                  <p class="body-small text-ink-secondary line-clamp-3">{post.data.summary}</p>
                )}
                <div class="mt-5 flex items-center gap-1 text-accent text-[13px] font-medium">
                  Read article
                  <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <MotionInit />
</Layout>
