---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Container from '../components/Container.astro';
import FeatureEncyclopedia from '../components/features/FeatureEncyclopedia.astro';
import FeatureJumpNav from '../components/features/FeatureJumpNav.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<Layout title="Features — Cardmaniacs">
  <SiteNav currentPage="features" />

  <main id="main-content">
    <section class="pt-16 pb-16 lg:pt-40 lg:pb-20">
      <Container>
        <PageHero
          eyebrow="Features"
          eyebrowIcon="sparkles"
          title="Your native reading desk."
          lede="Collect, triage, read, highlight, and revisit — feeds, read-later, parsing, media, and power-user tools in one calm Apple-native app."
        />
      </Container>
    </section>

    <FeatureJumpNav />
    <FeatureEncyclopedia />

    <CtaBanner />
  </main>

  <SiteFooter />
</Layout>
