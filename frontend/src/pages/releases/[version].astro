---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import Prose from '../../components/ui/Prose.astro';
import MarketingReaderSurface from '../../components/marketing/MarketingReaderSurface.astro';
import { getCollection, render } from 'astro:content';

/** Static HTML at build for content routes under `output: "server"`. */
export const prerender = true;

export async function getStaticPaths() {
  const releases = await getCollection('releases');
  return releases.map((release) => ({
    params: { version: release.id },
    props: { release },
  }));
}

const { release } = Astro.props;
const { Content } = await render(release);
---

<Layout title={`${release.data.title} — Cardmaniacs`}>
  <SiteNav />

  <main id="main-content">
    <article class="pt-32 pb-20 md:pt-40 md:pb-28">
      <Container narrow>
        <a href="/changelog" class="inline-flex items-center gap-1.5 ink-accent text-[13px] font-display font-medium mb-8 hover:underline underline-offset-2">
          <LucideIcon name="arrow-left" size={14} />
          Back to changelog
        </a>

        <MarketingReaderSurface
          title={release.data.title}
          source="Release notes"
          meta={release.data.date
            ? new Date(release.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
            : undefined}
          tags={[
            release.data.version ? `v${release.data.version}` : '',
            release.data.platforms ?? '',
          ].filter(Boolean)}
        >
          {release.data.highlights && (
            <p class="text-[1.125rem] ink-secondary mb-6">{release.data.highlights}</p>
          )}
          {release.data.downloadUrl && (
            <div class="mb-8">
              <Button href={release.data.downloadUrl}>Download</Button>
            </div>
          )}
          <Prose>
            <Content />
          </Prose>
        </MarketingReaderSurface>
      </Container>
    </article>
  </main>

  <SiteFooter />
</Layout>
