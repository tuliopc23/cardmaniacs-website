---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Container from '../components/Container.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((page) => ({
    params: { legal: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Layout title={`${page.data.title} — Cardmaniacs`}>
  <SiteNav />

  <main>
    <article class="pt-32 pb-20 md:pt-40 md:pb-28">
      <Container narrow>
        <header class="mb-10">
          <h1 class="display ink-primary mb-3">{page.data.title}</h1>
          {page.data.lastUpdated && (
            <p class="body-s ink-tertiary">
              Last updated: {new Date(page.data.lastUpdated).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </p>
          )}
        </header>
        <div class="prose">
          <Content />
        </div>
      </Container>
    </article>
  </main>

  <SiteFooter />
</Layout>

<style>
  .prose { font-size: 1.0625rem; line-height: 1.7; color: var(--ink-primary); }
  .prose :global(h2) { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; line-height: 1.2; letter-spacing: -0.025em; margin-top: 2.5rem; margin-bottom: 1rem; color: var(--ink-primary); }
  .prose :global(p) { margin-bottom: 1.25rem; color: var(--ink-secondary); }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(ul) { list-style: disc; padding-left: 1.5rem; margin-bottom: 1.25rem; }
  .prose :global(li) { margin-bottom: 0.5rem; color: var(--ink-secondary); }
</style>
