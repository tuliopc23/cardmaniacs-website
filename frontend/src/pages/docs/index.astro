---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Container from '../../components/Container.astro';
import BejamasCard from '../../components/ui/bejamas/Card.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import PageHero from '../../components/ui/PageHero.astro';
import EyebrowLabel from '../../components/ui/EyebrowLabel.astro';
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
const sections = new Map<string, typeof docs>();
docs.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)).forEach((doc) => {
  const section = doc.data.section ?? 'General';
  if (!sections.has(section)) sections.set(section, []);
  sections.get(section)!.push(doc);
});
---

<Layout title="Documentation — Cardmaniacs">
  <SiteNav />

  <main id="main-content">
    <section class="pt-16 pb-16 md:pt-40 md:pb-20">
      <Container>
        <PageHero
          eyebrow="Documentation"
          eyebrowIcon="book-open"
          title="Learn Cardmaniacs."
          lede="Guides, tips, and reference for getting the most out of your reading desk."
        />
      </Container>
    </section>

    <section class="pb-20">
      <Container>
        <div class="space-y-12">
          {[...sections.entries()].map(([section, items]) => (
            <div>
              <h2 class="type-section-title ink-primary mb-5 inline-flex items-center gap-2.5">
                <LucideIcon name="folder" size={20} class="shrink-0 text-[var(--accent)]" />
                {section}
              </h2>
              <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
                {items.map((doc) => (
                  <a href={`/docs/${doc.id}`} class="group block rounded-[var(--radius-card)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring-focus)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface-base)]">
                    <BejamasCard padding="md" hover class="h-full">
                      <h3 class="subheading ink-primary mb-2 transition-colors group-hover:text-[var(--accent)]">{doc.data.title}</h3>
                      <p class="body-s ink-tertiary flex items-center gap-1.5">
                        Read guide
                        <LucideIcon name="arrow-right" size={14} class="text-[var(--accent)] transition-transform group-hover:translate-x-0.5" />
                      </p>
                    </BejamasCard>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>
  </main>

  <SiteFooter />
</Layout>
