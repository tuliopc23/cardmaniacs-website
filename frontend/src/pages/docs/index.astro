---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Container from '../../components/Container.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
const sections = new Map<string, typeof docs>();
docs.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)).forEach((doc) => {
  const section = doc.data.section ?? 'General';
  if (!sections.has(section)) sections.set(section, []);
  sections.get(section)!.push(doc);
});
---

<Layout title="Documentation — Cardmaniacs">
  <SiteNav />

  <main>
    <section class="pt-32 pb-16 md:pt-40 md:pb-20">
      <Container>
        <div class="max-w-[680px]">
          <p class="caption ink-accent mb-5">Documentation</p>
          <h1 class="display-xl ink-primary mb-6">Learn Cardmaniacs.</h1>
          <p class="body-l ink-secondary max-w-[520px]">
            Guides, tips, and reference for getting the most out of your reading desk.
          </p>
        </div>
      </Container>
    </section>

    <section class="pb-20">
      <Container>
        <div class="space-y-10">
          {[...sections.entries()].map(([section, items]) => (
            <div>
              <h2 class="heading ink-primary mb-4">{section}</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {items.map((doc) => (
                  <Card variant="interactive" href={`/docs/${doc.id}`} class="p-5 block">
                    <h3 class="subheading ink-primary mb-1">{doc.data.title}</h3>
                    <p class="body-s ink-tertiary">Read guide →</p>
                  </Card>
                ))}
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>
  </main>

  <SiteFooter />
</Layout>
