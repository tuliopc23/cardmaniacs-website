---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Container from '../../components/Container.astro';
import Prose from '../../components/ui/Prose.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import EyebrowLabel from '../../components/ui/EyebrowLabel.astro';
import { getCollection, render } from 'astro:content';
import { docNeighbors, groupDocsBySection } from '../../lib/docs';

/** Static HTML at build for content routes under `output: "server"`. */
export const prerender = true;

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);

const allDocs = await getCollection('docs');
const sections = groupDocsBySection(allDocs);
const { previous, next } = docNeighbors(allDocs, doc.id);
---

<Layout title={`${doc.data.title} — Cardmaniacs Docs`}>
  <SiteNav currentPage="docs" />

  <main id="main-content" class="pt-16 pb-20 lg:pt-40 lg:pb-28">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-[220px_1fr] gap-12">
        <!-- Sidebar -->
        <aside class="hidden lg:block">
          <nav class="sticky top-28 space-y-6">
            {sections.map(([section, items]) => (
              <div>
                <EyebrowLabel class="mb-2 ink-tertiary">{section}</EyebrowLabel>
                <ul class="space-y-1">
                  {items.map((d) => (
                    <li>
                      <a
                        href={`/docs/${d.id}`}
                        class:list={[
                          'block body-s px-3 py-1.5 rounded-[var(--radius-sm)] transition-colors duration-200',
                          d.id === doc.id
                            ? 'ink-primary bg-[var(--accent-subtle)] font-medium'
                            : 'ink-secondary hover:ink-primary hover:bg-[var(--surface-overlay)]',
                        ]}
                      >
                        {d.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </aside>

        <!-- Content -->
        <article class="max-w-[680px]">
          <a href="/docs" class="mb-6 inline-flex items-center gap-1.5 text-[13px] font-display font-medium ink-accent hover:underline underline-offset-2 lg:hidden">
            <LucideIcon name="arrow-left" size={14} />
            All docs
          </a>
          {doc.data.section && <EyebrowLabel class="mb-2 ink-tertiary">{doc.data.section}</EyebrowLabel>}
          <h1 class="display-hero ink-primary mb-10 text-balance">{doc.data.title}</h1>
          <Prose>
            <Content />
          </Prose>

          {(previous || next) && (
            <nav
              class="mt-14 pt-8 border-t border-[var(--border-subtle)] grid gap-4 sm:grid-cols-2"
              aria-label="Documentation pages"
            >
              {previous ? (
                <a
                  href={`/docs/${previous.id}`}
                  class="group rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-[var(--surface-elevated)] p-4 transition-colors hover:border-[var(--accent)]/30"
                >
                  <span class="block text-[12px] font-display font-medium uppercase tracking-[0.06em] ink-tertiary mb-1">
                    Previous
                  </span>
                  <span class="body-s ink-primary group-hover:text-[var(--accent)]">{previous.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a
                  href={`/docs/${next.id}`}
                  class="group rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-[var(--surface-elevated)] p-4 text-right transition-colors hover:border-[var(--accent)]/30 sm:col-start-2"
                >
                  <span class="block text-[12px] font-display font-medium uppercase tracking-[0.06em] ink-tertiary mb-1">
                    Next
                  </span>
                  <span class="body-s ink-primary group-hover:text-[var(--accent)]">{next.data.title}</span>
                </a>
              )}
            </nav>
          )}
        </article>
      </div>
    </Container>
  </main>

  <SiteFooter />
</Layout>
