---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Container from '../components/Container.astro';
import PricingSection from '../components/PricingSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Card from '../components/Card.astro';

const faqs = [
  { q: 'What platforms does Cardmaniacs support?', a: 'Cardmaniacs is built natively for macOS, iOS, and iPadOS. Each version is optimized for its platform — full keyboard navigation on Mac, touch-first on iOS, and multitasking-ready on iPad.' },
  { q: 'Can I try before I subscribe?', a: 'Yes — Cardmaniacs includes a generous free trial period when you download from the App Store.' },
  { q: 'What feed formats are supported?', a: 'RSS, Atom, JSON Feed, YouTube channels, podcast feeds, Reddit subreddits, and Mastodon accounts.' },
  { q: 'Does it work offline?', a: 'Absolutely. Articles and documents are downloaded and cached locally for full offline reading.' },
  { q: 'How does sync work?', a: 'Cardmaniacs uses iCloud to sync subscriptions, saved articles, bookmarks, tags, and reading position across all your Apple devices. No account needed — just your Apple ID.' },
  { q: 'Can I import from other apps?', a: 'Yes. Cardmaniacs supports OPML import for RSS feeds, and can import bookmarks, PDFs, EPUB files, and Markdown documents.' },
];

const trustItems = [
  { icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>', title: 'Privacy first', desc: 'All data stays on your devices via iCloud' },
  { icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>', title: '100% native Swift', desc: 'No Electron, no web views' },
  { icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>', title: 'Indie crafted', desc: 'Built with care, not VC pressure' },
];
---

<Layout title="Pricing — Cardmaniacs">
  <SiteNav currentPage="pricing" />

  <main>
    <!-- Hero -->
    <section class="pt-32 pb-8 md:pt-40 md:pb-12">
      <Container>
        <div class="max-w-[680px]">
          <p class="caption ink-accent mb-5">Pricing</p>
          <h1 class="display-xl ink-primary mb-6">One plan.<br/>Everything included.</h1>
          <p class="body-l ink-secondary max-w-[520px]">
            No feature gates, no usage limits. Every Cardmaniacs feature, on every device, from day one.
          </p>
        </div>
      </Container>
    </section>

    <PricingSection compact />

    <!-- FAQ -->
    <section class="py-20 md:py-28">
      <Container>
        <div class="max-w-[560px] mb-12">
          <h2 class="display ink-primary">Questions & answers</h2>
        </div>

        <div class="max-w-[720px]">
          <Card variant="raised" class="divide-y divide-[var(--border-subtle)]">
            {faqs.map((faq) => (
              <details class="group">
                <summary class="flex items-center justify-between cursor-pointer list-none px-6 py-5">
                  <h3 class="subheading ink-primary pr-8 text-[15px]">{faq.q}</h3>
                  <svg class="w-4 h-4 ink-tertiary shrink-0 transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                </summary>
                <p class="body-s ink-secondary px-6 pb-5 pr-14 leading-relaxed">{faq.a}</p>
              </details>
            ))}
          </Card>
        </div>
      </Container>
    </section>

    <!-- Trust band -->
    <section class="py-12 border-t border-b border-[var(--border-subtle)]">
      <Container>
        <div class="flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-10">
          {trustItems.map((item) => (
            <div class="flex items-center gap-3">
              <div class="ink-tertiary">
                <Fragment set:html={item.icon} />
              </div>
              <div>
                <p class="body-s ink-primary font-medium">{item.title}</p>
                <p class="text-[12px] ink-tertiary">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <CtaBanner />
  </main>

  <SiteFooter />
</Layout>
