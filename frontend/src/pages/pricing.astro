---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingCards from '../components/PricingCards.astro';
import FinalCTA from '../components/FinalCTA.astro';
import MotionInit from '../components/MotionInit.astro';

const faqs = [
  {
    question: 'What platforms does Cardmaniacs support?',
    answer: 'Cardmaniacs is built natively for macOS, iOS, and iPadOS. Each version is optimized for its platform — full keyboard navigation on Mac, touch-first on iOS, and multitasking-ready on iPad.',
  },
  {
    question: 'Can I try before I subscribe?',
    answer: 'Yes — Cardmaniacs includes a generous free trial period when you download from the App Store, so you can explore every feature before committing.',
  },
  {
    question: 'What feed formats are supported?',
    answer: 'RSS, Atom, JSON Feed, YouTube channels, podcast feeds (via RSS), Reddit subreddits, and Mastodon accounts. If it publishes content, Cardmaniacs can probably read it.',
  },
  {
    question: 'Does it work offline?',
    answer: 'Absolutely. Articles and documents are downloaded and cached locally for full offline reading. Your reading queue travels with you.',
  },
  {
    question: 'How does sync work?',
    answer: 'Cardmaniacs uses iCloud to sync your subscriptions, saved articles, bookmarks, tags, and reading position across all your Apple devices. No account needed — just your Apple ID.',
  },
  {
    question: 'Can I import from other apps?',
    answer: 'Yes. Cardmaniacs supports OPML import for RSS feeds, and can import bookmarks, PDFs, EPUB files, and Markdown documents.',
  },
];
---

<Layout title="Pricing — Cardmaniacs">
  <Header currentPage="pricing" />
  
  <main data-testid="pricing-page">
    
    <!-- Pricing hero -->
    <section class="pt-28 pb-8 md:pt-36 md:pb-12 relative overflow-hidden atmosphere-hero">
      <div class="blob blob-lavender blob-animate w-[500px] h-[400px] -top-32 -left-24 absolute"></div>
      <div class="blob blob-blue blob-animate-delay w-[300px] h-[300px] top-20 right-[-60px] absolute opacity-30"></div>
      <div class="mx-auto max-w-[1120px] px-6 relative">
        <div class="max-w-[680px]">
          <p class="label text-accent mb-5">Pricing</p>
          <h1 class="heading-hero text-ink mb-6">
            One plan.<br/>Everything included.
          </h1>
          <p class="body-large text-ink-secondary max-w-[520px]">
            No feature gates, no usage limits, no upsell screens. Every Cardmaniacs feature, on every device, from day one.
          </p>
        </div>
      </div>
    </section>

    <div data-reveal>
      <PricingCards compact />
    </div>

    <!-- FAQ section -->
    <section class="section-gap" data-testid="faq-section">
      <div class="mx-auto max-w-[1120px] px-6">
        <div class="max-w-[560px] mb-12" data-reveal>
          <h2 class="heading-display text-ink">Questions & answers</h2>
        </div>

        <div class="max-w-[720px]" data-testid="faq-list" data-reveal-group>
          <div class="rounded-2xl overflow-hidden" style="background: var(--color-glass-bg-strong); backdrop-filter: blur(20px) saturate(1.6); border: 0.5px solid var(--color-glass-border-subtle); box-shadow: var(--shadow-glass-elevated);">
          {faqs.map((faq, i) => (
            <details 
              class="group" 
              data-testid={`faq-${i}`}
            >
              <summary class="flex items-center justify-between cursor-pointer list-none px-7 py-5" style={i > 0 ? 'border-top: 0.5px solid rgba(0,0,0,0.04);' : ''}>
                <h3 class="heading-subsection text-ink pr-8 text-[15px]">{faq.question}</h3>
                <svg class="w-4.5 h-4.5 text-ink-tertiary flex-shrink-0 transition-transform duration-300 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </summary>
              <p class="body-default text-ink-secondary px-7 pb-5 pr-14 text-[14px] leading-relaxed">{faq.answer}</p>
            </details>
          ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Trust band -->
    <section class="py-16 relative" data-testid="trust-band">
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-black/[0.06] to-transparent"></div>
      <div class="mx-auto max-w-[1120px] px-6">
        <div class="flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-10" data-reveal>
          <div class="flex items-center gap-3.5 px-5 py-3.5 rounded-xl" style="background: var(--color-glass-bg); backdrop-filter: blur(12px); border: 0.5px solid var(--color-glass-border-subtle); box-shadow: var(--shadow-glass);">
            <svg class="w-6 h-6 text-ink-tertiary flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            <div>
              <p class="text-ink font-medium text-[14px]">Privacy first</p>
              <p class="text-ink-tertiary text-[13px]">All data stays on your devices via iCloud</p>
            </div>
          </div>
          <div class="flex items-center gap-3.5 px-5 py-3.5 rounded-xl" style="background: var(--color-glass-bg); backdrop-filter: blur(12px); border: 0.5px solid var(--color-glass-border-subtle); box-shadow: var(--shadow-glass);">
            <svg class="w-6 h-6 text-ink-tertiary flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
            </svg>
            <div>
              <p class="text-ink font-medium text-[14px]">100% native Swift</p>
              <p class="text-ink-tertiary text-[12px]">No Electron, no web views</p>
            </div>
          </div>
          <div class="flex items-center gap-3.5 px-5 py-3.5 rounded-xl" style="background: var(--color-glass-bg); backdrop-filter: blur(12px); border: 0.5px solid var(--color-glass-border-subtle); box-shadow: var(--shadow-glass);">
            <svg class="w-6 h-6 text-ink-tertiary flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
            <div>
              <p class="text-ink font-medium text-[14px]">Indie crafted</p>
              <p class="text-ink-tertiary text-[12px]">Built with care, not VC pressure</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div data-reveal>
      <FinalCTA />
    </div>
  </main>

  <Footer />
  <MotionInit />
</Layout>
