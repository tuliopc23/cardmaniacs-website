---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Container from '../components/Container.astro';
import PricingSection from '../components/PricingSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import BejamasCard from '../components/ui/bejamas/Card.astro';
import PhosphorIcon from '../components/PhosphorIcon.astro';

const faqs = [
  { q: 'What platforms does Cardmaniacs support?', a: 'Cardmaniacs is built natively for macOS, iOS, and iPadOS. Each version is optimized for its platform — full keyboard navigation on Mac, touch-first on iOS, and multitasking-ready on iPad.' },
  { q: 'Can I try before I subscribe?', a: 'Yes — Cardmaniacs includes a generous free trial period when you download from the App Store.' },
  { q: 'What feed formats are supported?', a: 'RSS, Atom, JSON Feed, YouTube channels, podcast feeds, Reddit subreddits, and Mastodon accounts.' },
  { q: 'Does it work offline?', a: 'Absolutely. Articles and documents are downloaded and cached locally for full offline reading.' },
  { q: 'How does sync work?', a: 'Cardmaniacs uses iCloud to sync subscriptions, saved articles, bookmarks, tags, and reading position across all your Apple devices. No account needed — just your Apple ID.' },
  { q: 'Can I import from other apps?', a: 'Yes. Cardmaniacs supports OPML import for RSS feeds, and can import bookmarks, PDFs, EPUB files, and Markdown documents.' },
];

const trustItems = [
  { icon: 'shield-check' as const, title: 'Privacy first', desc: 'All data stays on your devices via iCloud' },
  { icon: 'code' as const, title: '100% native Swift', desc: 'No Electron, no web views' },
  { icon: 'heart' as const, title: 'Indie crafted', desc: 'Built with care, not VC pressure' },
];
---

<Layout title="Pricing — Cardmaniacs">
  <SiteNav currentPage="pricing" />

  <main id="main-content">
    <section class="pt-32 pb-8 md:pt-40 md:pb-12">
      <Container>
        <div class="max-w-[680px]">
          <p class="editorial-eyebrow editorial-eyebrow-accent mb-4">Pricing</p>
          <h1 class="display-hero ink-primary mb-6">One plan.<br />Everything included.</h1>
          <p class="type-lede measure-tight">
            No feature gates, no usage limits. Every Cardmaniacs feature, on every device, from day one.
          </p>
        </div>
      </Container>
    </section>

    <PricingSection compact />

    <section class="py-20 md:py-28">
      <Container>
        <div class="max-w-[560px] mb-12">
          <h2 class="type-section-title ink-primary">Questions & answers</h2>
        </div>

        <div class="max-w-[720px]">
          <BejamasCard padding="none" class="divide-y divide-[var(--border-subtle)] overflow-hidden">
            {faqs.map((faq) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--ring-focus)]">
                  <h3 class="subheading ink-primary pr-8 text-[15px]">{faq.q}</h3>
                  <span class="ink-tertiary shrink-0 transition-transform duration-200 group-open:rotate-45">
                    <PhosphorIcon name="plus" size={18} />
                  </span>
                </summary>
                <p class="body-s ink-secondary px-6 pb-5 pr-14 leading-relaxed">{faq.a}</p>
              </details>
            ))}
          </BejamasCard>
        </div>
      </Container>
    </section>

    <section class="section-band py-12">
      <Container>
        <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:gap-10">
          {trustItems.map((item) => (
            <div class="flex items-center gap-3">
              <div class="ink-tertiary">
                <PhosphorIcon name={item.icon} size={22} />
              </div>
              <div>
                <p class="body-s font-medium ink-primary">{item.title}</p>
                <p class="text-[12px] ink-tertiary">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <CtaBanner />
  </main>

  <SiteFooter />
</Layout>
