---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Container from '../../components/Container.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ReleaseCard from '../../components/site/ReleaseCard.astro';
import Surface from '../../components/ui/Surface.astro';
import { getCollection, render } from 'astro:content';

const entries = await getCollection('changelog');
const sorted = entries.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});
---

<Layout title="Changelog — Cardmaniacs">
  <SiteNav currentPage="changelog" />

  <main id="main-content">
    <section class="pt-16 pb-16 md:pt-40 md:pb-20">
      <Container>
        <PageHero
          eyebrow="Changelog"
          eyebrowIcon="history"
          title="Release journal."
          lede="Every update, improvement, and fix — written like a shipping log."
        />
      </Container>
    </section>

    <section class="pb-20 md:pb-24">
      <Container>
        {sorted.length === 0 ? (
          <Surface variant="elevated" radius="card" class="max-w-[560px] mx-auto p-8 md:p-10 text-center">
            <h2 class="type-section-title ink-primary mb-3">Shipping log starts here.</h2>
            <p class="type-lede measure-tight mx-auto ink-secondary">
              Release notes will appear as Cardmaniacs ships. Follow along on the blog for longer-form updates.
            </p>
          </Surface>
        ) : (
        <div class="flex flex-col gap-10 md:gap-12">
          {sorted.map(async (entry) => {
            const { Content } = await render(entry);
            return (
              <ReleaseCard
                version={entry.data.version}
                type={entry.data.type}
                platform={entry.data.platform}
                date={entry.data.date}
                title={entry.data.title}
              >
                  <Content />
              </ReleaseCard>
            );
          })}
        </div>
        )}
      </Container>
    </section>
  </main>

  <SiteFooter />
</Layout>
