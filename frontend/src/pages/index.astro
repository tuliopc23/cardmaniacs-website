---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import WorkflowSections from '../components/WorkflowSections.astro';
import ReadingDesk from '../components/ReadingDesk.astro';
import TrustSection from '../components/TrustSection.astro';
import PricingCards from '../components/PricingCards.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import MotionInit from '../components/MotionInit.astro';
---

<Layout>
  <Header currentPage="home" />
  
  <main data-testid="home-page">
    <Hero />
    <ProofStrip />
    
    <div data-reveal>
      <WorkflowSections />
    </div>
    
    <div data-reveal>
      <ReadingDesk />
    </div>
    
    <div data-reveal>
      <TrustSection />
    </div>
    
    <div data-reveal>
      <PricingCards compact />
    </div>
    
    <div data-reveal>
      <FinalCTA />
    </div>
  </main>

  <Footer />
  <MotionInit />
</Layout>
