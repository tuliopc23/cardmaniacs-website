---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteAmbient from '../components/site/SiteAmbient.astro';
import MotionBootstrap from '../components/MotionBootstrap.astro';
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
} from '../lib/site-icons';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const {
  title = 'Cardmaniacs — Your calm reading desk for feeds, articles & bookmarks',
  description = 'A native Apple app that unifies RSS feeds, Read Later, and Bookmarks into one beautifully crafted experience. Built for macOS, iOS & iPadOS.',
  ogImage = DEFAULT_OG_IMAGE,
  ogImageWidth = DEFAULT_OG_IMAGE_WIDTH,
  ogImageHeight = DEFAULT_OG_IMAGE_HEIGHT,
} = Astro.props;

const siteOrigin = Astro.site ?? 'https://cardmaniacs.app';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImageUrl = new URL(ogImage, siteOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta id="cm-theme-color" name="theme-color" content="#f5f7fa" />

    <!-- Theme flash prevention — runs before paint -->
    <script is:inline>
      (function() {
        var themeColors = { light: '#f5f7fa', dark: '#0e1012' };
        function syncThemeColor() {
          var theme =
            document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
          var meta = document.getElementById('cm-theme-color');
          if (meta) meta.setAttribute('content', themeColors[theme]);
        }
        window.cmSyncThemeColor = syncThemeColor;
        var stored = localStorage.getItem('cm-theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.setAttribute('data-theme', stored);
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
        syncThemeColor();
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("motion-enhanced");
        }
      })();
    </script>

    <!-- Preload critical font -->
    <link
      rel="preload"
      href="/fonts/Satoshi-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <ClientRouter />
  </head>
  <body>
    <SiteAmbient />
    <a class="skip-to-main" href="#main-content">Skip to content</a>
    <div class="relative z-[1] min-h-dvh cm-mobile-dock-pad" transition:animate="fade">
      <slot />
    </div>
    <MotionBootstrap />
  </body>
</html>
