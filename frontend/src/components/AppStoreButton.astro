---
import { downloadCta } from "../lib/site-cta";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const baseClass =
  "inline-flex items-center gap-3 px-5 py-2.5 rounded-[var(--radius-md)] transition-[transform,opacity,box-shadow,background-color,border-color] duration-200 group";
const activeClass =
  "hover:scale-[1.02] active:scale-[0.98] bg-[var(--ink-primary)] border border-[var(--border-subtle)] shadow-[var(--shadow-card)]";
const pendingClass =
  "cursor-default bg-[color-mix(in_oklab,var(--surface-overlay)_65%,transparent)] border border-[var(--border-subtle)] shadow-[var(--shadow-pill)]";
---

{
  downloadCta.isAvailable ? (
    <a
      href={downloadCta.href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[baseClass, activeClass, className]}
    >
      <svg class="w-6 h-6 flex-shrink-0 text-[var(--surface-base)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 21.99 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 21.99C7.79 22.03 6.8 20.68 5.96 19.47C4.25 16.97 2.94 12.45 4.7 9.39C5.57 7.87 7.13 6.91 8.82 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z" />
      </svg>
      <div class="flex flex-col text-[var(--surface-base)]">
        <span class="text-[10px] opacity-60 leading-none">{downloadCta.sublabel}</span>
        <span class="text-[16px] font-display font-semibold leading-tight tracking-tight">{downloadCta.label}</span>
      </div>
    </a>
  ) : (
    <span
      role="status"
      class:list={[baseClass, pendingClass, className]}
      aria-label={downloadCta.label}
    >
      <svg class="w-6 h-6 flex-shrink-0 ink-secondary opacity-70" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 21.99 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 21.99C7.79 22.03 6.8 20.68 5.96 19.47C4.25 16.97 2.94 12.45 4.7 9.39C5.57 7.87 7.13 6.91 8.82 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z" />
      </svg>
      <div class="flex flex-col ink-secondary">
        <span class="text-[10px] opacity-70 leading-none">
          <span translate="no">Cardmaniacs</span> for Mac, iPhone & iPad
        </span>
        <span class="text-[15px] font-display font-semibold leading-tight tracking-tight">{downloadCta.label}</span>
      </div>
    </span>
  )
}
