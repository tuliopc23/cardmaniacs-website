---
import { downloadCta } from "../lib/site-cta";
import AppleLogo from "./ui/AppleLogo.astro";

interface Props {
  class?: string;
  fullWidth?: boolean;
}

const { class: className = "", fullWidth = false } = Astro.props;

const baseClass =
  "inline-flex items-center gap-3 px-5 py-2.5 rounded-[var(--radius-md)] transition-[transform,opacity,box-shadow,background-color,border-color] duration-200 group";
const activeClass =
  "hover:scale-[1.02] active:scale-[0.98] bg-[var(--ink-primary)] border border-[var(--border-subtle)] shadow-[var(--shadow-card)]";
const storeChromeClass =
  "bg-[var(--ink-primary)] border border-[var(--border-subtle)] shadow-[var(--shadow-card)]";
---

{
  downloadCta.isAvailable ? (
    <a
      href={downloadCta.href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[baseClass, activeClass, fullWidth && "w-full justify-center", className]}
    >
      <AppleLogo size={24} class="text-[var(--surface-base)]" />
      <div class="flex flex-col text-[var(--surface-base)] text-left">
        <span class="text-[10px] opacity-60 leading-none">{downloadCta.sublabel}</span>
        <span class="text-[16px] font-display font-semibold leading-tight tracking-tight">{downloadCta.label}</span>
      </div>
    </a>
  ) : (
    <span
      role="status"
      class:list={[baseClass, storeChromeClass, "cursor-default", fullWidth && "w-full justify-center", className]}
      aria-label="Get the App"
    >
      <AppleLogo size={24} class="text-[var(--surface-base)]" />
      <div class="flex flex-col text-[var(--surface-base)] text-left">
        <span class="text-[10px] opacity-60 leading-none">{downloadCta.sublabel}</span>
        <span class="text-[16px] font-display font-semibold leading-tight tracking-tight">{downloadCta.label}</span>
      </div>
    </span>
  )
}
