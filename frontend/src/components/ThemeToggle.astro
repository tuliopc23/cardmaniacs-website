---
import PhosphorIcon from "./PhosphorIcon.astro";
---

<div
  id="theme-segment"
  class="cm-theme-segment shrink-0"
  role="radiogroup"
  aria-label="Color theme"
>
  <button
    type="button"
    id="theme-segment-light"
    class="cm-theme-segment__btn min-w-[3.25rem]"
    role="radio"
    aria-checked="false"
    data-theme-pick="light"
  >
    <span class="inline-flex items-center justify-center gap-1">
      <PhosphorIcon name="sun-dim" size={14} weight="bold" class="opacity-90" />
      <span class="inline">Light</span>
    </span>
  </button>
  <button
    type="button"
    id="theme-segment-dark"
    class="cm-theme-segment__btn min-w-[3.25rem]"
    role="radio"
    aria-checked="false"
    data-theme-pick="dark"
  >
    <span class="inline-flex items-center justify-center gap-1">
      <PhosphorIcon name="moon-stars" size={14} weight="bold" class="opacity-90" />
      <span class="inline">Dark</span>
    </span>
  </button>
</div>

<script>
  function initThemeSegment() {
    const group = document.getElementById("theme-segment");
    const light = document.getElementById("theme-segment-light");
    const dark = document.getElementById("theme-segment-dark");
    if (
      !(group instanceof HTMLElement) ||
      !(light instanceof HTMLButtonElement) ||
      !(dark instanceof HTMLButtonElement)
    )
      return;

    const readTheme = () =>
      document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";

    const applySegment = () => {
      const t = readTheme();
      const isLight = t === "light";
      light.setAttribute("aria-checked", String(isLight));
      dark.setAttribute("aria-checked", String(!isLight));
      light.tabIndex = isLight ? 0 : -1;
      dark.tabIndex = isLight ? -1 : 0;
    };

    const setTheme = (next: "light" | "dark") => {
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("cm-theme", next);
      } catch {
        /* ignore quota / private mode */
      }
      applySegment();
    };

    applySegment();

    light.addEventListener("click", () => setTheme("light"));
    dark.addEventListener("click", () => setTheme("dark"));

    group.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight" || e.key === "ArrowDown") {
        e.preventDefault();
        setTheme("dark");
        dark.focus();
      } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
        e.preventDefault();
        setTheme("light");
        light.focus();
      }
    });
  }

  initThemeSegment();
  document.addEventListener("astro:after-swap", initThemeSegment);
</script>
