---
import Container from './Container.astro';
import AppStoreButton from './AppStoreButton.astro';
import LucideIcon from './LucideIcon.astro';
---

<section class="relative py-24 md:py-32 text-center overflow-hidden cm-cta-band" id="get-the-app" data-reveal>
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.06] [background:radial-gradient(ellipse_70%_50%_at_50%_50%,var(--accent-atmo-cta-wash)_0%,transparent_70%)]"
  ></div>

  <Container class="relative z-10">
    <h2 class="display-xl ink-primary mb-6 max-w-[600px] mx-auto text-balance">
      Your reading desk<br />is ready.
    </h2>
    <p class="body-l ink-secondary mb-10 max-w-[440px] mx-auto leading-relaxed">
      Download Cardmaniacs on Mac, iPhone, and iPad — one subscription, every feature.
    </p>
    <AppStoreButton class="mx-auto" />
    <p class="caption ink-tertiary mt-6 inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
      <span class="inline-flex items-center gap-1">
        <LucideIcon name="device-mobile" size={12} />
        iOS
      </span>
      <span class="inline-flex items-center gap-1">
        <LucideIcon name="device-tablet" size={12} />
        iPadOS
      </span>
      <span class="inline-flex items-center gap-1">
        <LucideIcon name="keyboard" size={12} />
        macOS
      </span>
    </p>
  </Container>
</section>
