---
import { getIconNode } from "../lib/icons/registry";
import { iconToSvg } from "../lib/icons/iconToSvg";

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
  /** Heavier stroke for compact UI (e.g. theme toggle). */
  weight?: "regular" | "bold";
}

const { name, size = 24, class: className = "", strokeWidth, weight = "regular" } = Astro.props;

const node = getIconNode(name);
const resolvedStroke = strokeWidth ?? (weight === "bold" ? 2.5 : 2);
const svgContent = node ? iconToSvg(node, { size, strokeWidth: resolvedStroke }) : "";

if (!svgContent && import.meta.env.DEV) {
  console.warn(`[LucideIcon] Missing icon: ${name}`);
}
---

{
  svgContent && (
    <span
      class:list={[
        "cm-lucide inline-block shrink-0 text-current [&>svg]:block [&>svg]:h-full [&>svg]:w-full",
        className,
      ]}
      style={`width:${size}px;height:${size}px`}
      aria-hidden="true"
      set:html={svgContent}
    />
  )
}
