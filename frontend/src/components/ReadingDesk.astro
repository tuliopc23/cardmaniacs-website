---
---

<section data-testid="reading-desk-section" class="section-gap atmosphere-desk relative overflow-hidden">
  
  <div class="mx-auto max-w-[1120px] px-6 relative z-10">
    <div class="max-w-[560px] mb-20">
      <p class="label text-accent mb-5 tracking-[0.08em]">Your Reading Desk</p>
      <h2 class="heading-display text-ink mb-6">
        Everything you read,<br/>beautifully arranged.
      </h2>
      <p class="body-large text-ink-secondary leading-relaxed">
        Cards, not lists. Each piece of content is a tactile object on your desk — 
        articles, feeds, PDFs, bookmarks — all in one calm, organized surface.
      </p>
    </div>

    <!-- Composition of overlapping screenshots with depth -->
    <div class="relative" data-testid="reading-desk-composition">
      <!-- Main large screenshot -->
      <div class="macbook-frame max-w-[820px] relative z-10">
        <div class="macbook-frame-specular"></div>
        <img 
          src="/images/Cardmaniacs-mac - 4.png" 
          alt="Cardmaniacs reading desk overview" 
          loading="lazy"
          class="w-full"
        />
      </div>

      <!-- Overlapping card 1 — offset right, slight rotation -->
      <div class="hidden md:block absolute -right-8 top-20 w-[340px] z-20 transition-transform duration-700 hover:translate-y-[-4px]">
        <div class="macbook-frame" style="transform: rotate(2deg);">
          <div class="macbook-frame-specular"></div>
          <img 
            src="/images/Cardmaniacs-mac - 6.png" 
            alt="Cardmaniacs article detail" 
            loading="lazy"
            class="w-full"
          />
        </div>
      </div>

      <!-- Overlapping card 2 — offset left, slight counter-rotation -->
      <div class="hidden md:block absolute -left-8 -bottom-8 w-[300px] z-20 transition-transform duration-700 hover:translate-y-[-4px]">
        <div class="macbook-frame" style="transform: rotate(-1.5deg);">
          <div class="macbook-frame-specular"></div>
          <img 
            src="/images/Cardmaniacs-mac - 8.png" 
            alt="Cardmaniacs sidebar" 
            loading="lazy"
            class="w-full"
          />
        </div>
      </div>

      <!-- Floor glow -->
      <div class="absolute left-1/2 -translate-x-1/2 bottom-[-50px] w-[70%] h-[100px] rounded-full blur-[80px] opacity-15 bg-gradient-to-r from-orange-200 via-purple-200 to-blue-200 pointer-events-none"></div>
    </div>
  </div>
</section>
