---
---

<section data-testid="reading-desk-section" class="section-gap relative overflow-hidden">
  <!-- Background organic forms -->
  <div class="blob blob-peach w-[700px] h-[500px] top-0 left-1/3 absolute"></div>
  <div class="blob blob-lavender w-[500px] h-[500px] bottom-0 right-1/4 absolute"></div>

  <div class="mx-auto max-w-[1120px] px-6 relative">
    <div class="max-w-[560px] mb-16">
      <p class="label text-accent mb-4">Your Reading Desk</p>
      <h2 class="heading-display text-ink mb-5">
        Everything you read,<br/>beautifully arranged.
      </h2>
      <p class="body-large text-ink-secondary">
        Cards, not lists. Each piece of content is a tactile object on your desk — 
        articles, feeds, PDFs, bookmarks — all in one calm, organized surface.
      </p>
    </div>

    <!-- Composition of overlapping screenshots -->
    <div class="relative" data-testid="reading-desk-composition">
      <!-- Main large screenshot -->
      <div class="macbook-frame max-w-[820px] relative z-10">
        <img 
          src="/images/Cardmaniacs-mac - 4.png" 
          alt="Cardmaniacs reading desk overview" 
          loading="lazy"
          class="w-full"
        />
      </div>

      <!-- Overlapping card 1 -->
      <div class="hidden md:block absolute -right-6 top-16 w-[320px] z-20">
        <div class="macbook-frame rotate-2">
          <img 
            src="/images/Cardmaniacs-mac - 6.png" 
            alt="Cardmaniacs article detail" 
            loading="lazy"
            class="w-full"
          />
        </div>
      </div>

      <!-- Overlapping card 2 -->
      <div class="hidden md:block absolute -left-6 -bottom-12 w-[280px] z-20">
        <div class="macbook-frame -rotate-1">
          <img 
            src="/images/Cardmaniacs-mac - 8.png" 
            alt="Cardmaniacs sidebar" 
            loading="lazy"
            class="w-full"
          />
        </div>
      </div>
    </div>
  </div>
</section>
