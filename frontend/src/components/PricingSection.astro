---
import SectionBlock from './SectionBlock.astro';
import PricingCard from './site/PricingCard.astro';
import { appStoreUrl, hasAppStoreUrl } from '../lib/site-cta';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const planCtaHref = hasAppStoreUrl ? appStoreUrl : undefined;
const planCtaLabel = hasAppStoreUrl ? undefined : 'Coming to the App Store';

const trialFeatures = [
  'Full app access for 7 days',
  'Every feature on macOS, iOS & iPadOS',
  'Choose Monthly or Annual when you subscribe',
];

const monthlyFeatures = [
  'Every feature on macOS, iOS & iPadOS',
  'iCloud sync & offline reading',
  'Cancel anytime',
];

const annualFeatures = [
  'Everything in Monthly',
  'Best value — billed annually',
  'Priority access to new features',
];
---

<SectionBlock
  label={compact ? undefined : 'Pricing'}
  heading={compact ? undefined : 'Simple, fair pricing.'}
  class={compact ? 'py-12 md:py-16' : ''}
>
  {!compact && (
    <p class="type-lede measure-tight -mt-8 mb-12">
      Start with a 7-day trial, then choose Monthly or Annual. No feature gates — the same app on every plan.
      {!hasAppStoreUrl && (
        <span class="block mt-3 body-s ink-tertiary">
          Subscription pricing below is illustrative until App Store launch.
        </span>
      )}
    </p>
  )}

  <div
    class="mx-auto grid w-full max-w-[1120px] grid-cols-1 gap-4 sm:gap-5 md:grid-cols-2 md:gap-5 lg:grid-cols-3 lg:gap-6"
  >
    <PricingCard
      class="md:col-span-2 lg:col-span-1"
      label="7-day trial"
      price="$0"
      interval="/ trial"
      description="Try everything before you subscribe."
      ctaHref={planCtaHref}
      ctaLabel={planCtaLabel ?? 'Start free trial'}
      badge="Try it"
      features={trialFeatures}
    />

    <PricingCard
      label="Monthly"
      price="$4.99"
      interval="/month"
      description="Full access, cancel anytime."
      ctaHref={planCtaHref}
      ctaLabel={planCtaLabel}
      features={monthlyFeatures}
    />

    <PricingCard
      label="Annual"
      price="$29.99"
      interval="/year"
      description="Best value — $2.50/month."
      ctaHref={planCtaHref}
      ctaLabel={planCtaLabel}
      highlighted
      badge="Save 50%"
      features={annualFeatures}
    />
  </div>
</SectionBlock>
