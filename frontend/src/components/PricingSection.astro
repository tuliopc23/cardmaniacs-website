---
import SectionBlock from './SectionBlock.astro';
import PricingCard from './site/PricingCard.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const monthlyFeatures = [
  'Every feature on macOS, iOS & iPadOS',
  'iCloud sync & offline reading',
  'Cancel anytime',
];

const annualFeatures = [
  'Everything in Monthly',
  'Best value — billed annually',
  'Priority access to new features',
];
---

<SectionBlock
  label={compact ? undefined : 'Pricing'}
  heading={compact ? undefined : 'Simple, fair pricing.'}
  class={compact ? 'py-12 md:py-16' : ''}
>
  {!compact && (
    <p class="type-lede measure-tight -mt-8 mb-12">
      No free tier, no feature gates, no upsell pressure. One plan with everything included.
    </p>
  )}

  <div class="flex flex-col sm:flex-row gap-5 max-w-[640px]">
    <PricingCard
      label="Monthly"
      price="$4.99"
      interval="/month"
      description="Full access, cancel anytime."
      ctaHref="#download"
      ctaVariant="secondary"
      features={monthlyFeatures}
    />

    <PricingCard
      label="Annual"
      price="$29.99"
      interval="/year"
      description="Best value — $2.50/month."
      ctaHref="#download"
      ctaVariant="primary"
      highlighted
      badge="Save 50%"
      features={annualFeatures}
    />
  </div>
</SectionBlock>
