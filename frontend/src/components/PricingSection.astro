---
import SectionBlock from './SectionBlock.astro';
import PricingCard from './site/PricingCard.astro';
import { hasAppStoreUrl } from '../lib/site-cta';

interface Props {
  compact?: boolean;
  reveal?: boolean;
}

const { compact = false, reveal = false } = Astro.props;

const trialFeatures = [
  'Full app access for 7 days',
  'Every feature on macOS, iOS & iPadOS',
  'Choose Monthly or Annual when you subscribe',
];

const monthlyFeatures = [
  'Every feature on macOS, iOS & iPadOS',
  'iCloud sync & offline reading',
  'Cancel anytime',
];

const annualFeatures = [
  'Everything in Monthly',
  'Best value — billed annually',
  'Priority access to new features',
];
---

<SectionBlock
  label={compact ? undefined : 'Pricing'}
  icon={compact ? undefined : 'credit-card'}
  heading={compact ? undefined : 'Simple, fair pricing.'}
  class={compact ? 'py-12 md:py-16' : ''}
  reveal={reveal}
>
  {!compact && (
    <p class="type-lede measure-tight -mt-8 mb-12">
      Start with a 7-day trial, then choose Monthly or Annual. No feature gates — the same app on every plan.
      {!hasAppStoreUrl && (
        <span class="block mt-3 body-s ink-tertiary">
          Subscription pricing below is illustrative until App Store launch.
        </span>
      )}
    </p>
  )}

  <div
    class="mx-auto grid w-full max-w-[1040px] grid-cols-1 gap-4 sm:gap-5 lg:grid-cols-[minmax(0,1.06fr)_minmax(0,0.94fr)] lg:gap-6 lg:items-stretch"
    data-reveal-stagger={reveal ? true : undefined}
  >
    <div class="lg:min-h-0" data-reveal-card={reveal ? true : undefined}>
      <PricingCard
        label="Annual"
        price="$34.99"
        interval="/year"
        description="Best value — $2.92/month. Everything included on every Apple device."
        highlighted
        badge="Save 42%"
        features={annualFeatures}
        layout="tall"
        class="max-w-none h-full"
      />
    </div>

    <div class="flex flex-col gap-4 sm:gap-5 lg:gap-6 lg:min-h-0">
      <div class="lg:flex-1 lg:min-h-0" data-reveal-card={reveal ? true : undefined}>
        <PricingCard
          label="7-day trial"
          price="$0"
          interval="/ trial"
          description="Try everything before you subscribe."
          badge="Try it"
          features={trialFeatures}
          layout="compact"
          class="max-w-none h-full"
        />
      </div>

      <div class="lg:flex-1 lg:min-h-0" data-reveal-card={reveal ? true : undefined}>
        <PricingCard
          label="Monthly"
          price="$4.99"
          interval="/month"
          description="Full access, cancel anytime."
          features={monthlyFeatures}
          layout="compact"
          class="max-w-none h-full"
        />
      </div>
    </div>
  </div>
</SectionBlock>
