---
import FeatureItem from "./FeatureItem.astro";
import PhosphorIcon from "./PhosphorIcon.astro";

interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<FeatureItem>
  <span slot="media" class="inline-flex size-8 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--accent-subtle)] ink-accent shrink-0">
    <PhosphorIcon name={icon} size={18} />
  </span>
  <h3 slot="title" class="subheading ink-primary">
    {title}
  </h3>
  <p slot="description" class="body-s ink-secondary leading-relaxed">
    {description}
  </p>
</FeatureItem>
