---
import FeatureItem from "./FeatureItem.astro";
import IconWell from "./ui/IconWell.astro";

interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<FeatureItem>
  <IconWell slot="media" icon={icon} size="md" />
  <h3 slot="title" class="type-card-title">{title}</h3>
  <p slot="description" class="type-card-meta leading-relaxed text-[var(--ink-secondary)]">
    {description}
  </p>
</FeatureItem>
