---
/**
 * Renders Phosphor icons from @phosphor-icons/core (regular weight fallback).
 * Semantic aliases map marketing / nav ids to asset file names.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;

const normalized = name.trim().toLowerCase();

const iconMap: Record<string, string> = {
  "arrow-left": "arrow-left",
  "arrow-right": "arrow-right",
  "chevron-right": "caret-right",
  "chevron-left": "caret-left",
  article: "article",
  rss: "rss",
  "bookmark-simple": "bookmark-simple",
  bookmarks: "bookmarks",
  folder: "folder",
  list: "list",
  menu: "list",
  x: "x",
  close: "x",
  sun: "sun",
  moon: "moon",
  check: "check",
  "check-circle": "check-circle",
  plus: "plus",
  clock: "clock",
  code: "code",
  heart: "heart",
  "shield-check": "shield-check",
  "device-mobile": "device-mobile",
  "device-tablet": "device-tablet",
  "book-open": "book-open-text",
  "book-open-text": "book-open-text",
  search: "magnifying-glass",
  tag: "tag",
  sparkles: "sparkle",
  sparkle: "sparkle",
  envelope: "envelope",
};

const phosphorName = iconMap[normalized] ?? normalized;

/* Explicit glob so Vite resolves only used icons (extend when adding new `name`s). */
const phosphorAssetModules = import.meta.glob(
  "../../node_modules/@phosphor-icons/core/assets/regular/{arrow-left,arrow-right,article,broadcast,bookmark-simple,bookmarks,book-open-text,caret-right,check,check-circle,clock,cloud-arrow-down,code,device-mobile,device-tablet,file-text,folder,heart,keyboard,list,magnifying-glass,moon,plus,rss,shield-check,sparkle,sun,tag,x}.svg",
  { eager: true, query: "?raw", import: "default" },
) as Record<string, string>;

let svgContent = "";
const iconPath = `../../node_modules/@phosphor-icons/core/assets/regular/${phosphorName}.svg`;
const asset = phosphorAssetModules[iconPath];
if (typeof asset === "string" && asset.length > 0) {
  svgContent = asset;
}

if (!svgContent && import.meta.env.DEV) {
  console.warn(`[PhosphorIcon] Missing asset: ${phosphorName}`);
}
---

{
  svgContent && (
    <span
      class:list={["cm-phosphor inline-block shrink-0 text-current [&>svg]:block [&>svg]:h-full [&>svg]:w-full", className]}
      style={`width:${size}px;height:${size}px`}
      aria-hidden="true"
      set:html={svgContent}
    />
  )
}

