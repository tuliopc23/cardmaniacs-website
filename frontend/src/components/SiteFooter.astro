---
import Container from './Container.astro';
import Divider from './Divider.astro';
---

<footer class="pt-16 pb-12">
  <Container>
    <Divider class="mb-12" />

    <div class="grid grid-cols-2 md:grid-cols-5 gap-10 md:gap-8">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-2">
        <a href="/" class="flex items-center gap-2 mb-4">
          <img src="/images/Graphic.png" alt="Cardmaniacs" class="w-6 h-6 rounded-[6px]" width="24" height="24" />
          <span class="font-display font-semibold text-[14px] tracking-[-0.02em] ink-primary">Cardmaniacs</span>
        </a>
        <p class="body-s ink-tertiary max-w-[280px] leading-relaxed">
          Your calm reading desk for feeds, articles & bookmarks. Crafted natively for Apple platforms.
        </p>
      </div>

      <!-- Product -->
      <div>
        <h4 class="caption ink-tertiary mb-4">Product</h4>
        <ul class="space-y-2.5">
          <li><a href="/features" class="body-s ink-secondary hover:ink-primary transition-colors duration-200">Features</a></li>
          <li><a href="/pricing" class="body-s ink-secondary hover:ink-primary transition-colors duration-200">Pricing</a></li>
          <li><a href="#download" class="body-s ink-secondary hover:ink-primary transition-colors duration-200">Download</a></li>
          <li><a href="/changelog" class="body-s ink-secondary hover:ink-primary transition-colors duration-200">Changelog</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="caption ink-tertiary mb-4">Resources</h4>
        <ul class="space-y-2.5">
          <li><a href="/blog" class="body-s ink-secondary hover:ink-primary transition-colors duration-200">Blog</a></li>
          <li><a href="/docs" class="body-s ink-secondary hover:ink-primary transition-colors duration-200">Docs</a></li>
          <li><a href="/press" class="body-s ink-secondary hover:ink-primary transition-colors duration-200">Press Kit</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="caption ink-tertiary mb-4">Legal</h4>
        <ul class="space-y-2.5">
          <li><a href="/privacy" class="body-s ink-secondary hover:ink-primary transition-colors duration-200">Privacy</a></li>
          <li><a href="/terms" class="body-s ink-secondary hover:ink-primary transition-colors duration-200">Terms</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-[var(--border-subtle)] flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
      <p class="body-s ink-tertiary">
        &copy; {new Date().getFullYear()} Cardmaniacs. All rights reserved.
      </p>
      <p class="body-s ink-tertiary">
        Crafted for macOS, iOS & iPadOS
      </p>
    </div>
  </Container>
</footer>
