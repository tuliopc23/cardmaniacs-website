---
import Container from './Container.astro';
import BejamasSeparator from './ui/bejamas/Separator.astro';
import PhosphorIcon from './PhosphorIcon.astro';

const footerLinkClass =
  'group flex items-center justify-between gap-2 body-s font-medium ink-secondary hover:ink-primary transition-colors rounded-[var(--radius-sm)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring-focus)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface-base)]';
const chevronClass =
  'shrink-0 text-[var(--ink-tertiary)] transition-transform group-hover:translate-x-0.5';
---

<footer class="pt-16 pb-12 footer-ambient-edge">
  <Container>
    <div class="section-module p-8 md:p-10">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-4">
          <a
            href="/"
            class="mb-5 inline-flex items-center gap-2.5 rounded-[var(--radius-sm)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring-focus)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface-base)]"
          >
            <span
              class="flex size-9 shrink-0 items-center justify-center rounded-[12px] shadow-[var(--shadow-logo-mark)]"
            >
              <img
                src="/images/Cardmaniacs-icon-white.png"
                alt="Cardmaniacs"
                class="size-[22px] object-contain"
                width="22"
                height="22"
                loading="lazy"
              />
            </span>
            <span class="font-display font-semibold text-[15px] tracking-[-0.02em] ink-primary">Cardmaniacs</span>
          </a>
          <p class="type-lede measure-tight !text-[0.98rem]">
            A calmer home for everything you read — feeds, read-later, bookmarks, highlights, and the things you actually want to revisit.
          </p>
          <div class="mt-6 flex flex-wrap gap-x-3 gap-y-2 text-[13px] font-display font-semibold">
            <a href="#download" class="ink-accent hover:underline underline-offset-4">Download</a>
            <span class="ink-faint">·</span>
            <a href="/features" class="ink-secondary hover:ink-primary transition-colors">Explore features</a>
          </div>
        </div>

        <div class="lg:col-span-8">
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3">
            <div>
              <p class="editorial-eyebrow mb-4">Product</p>
              <ul class="space-y-2.5">
                <li>
                  <a href="/features" class={footerLinkClass}>
                    <span>Features</span>
                    <PhosphorIcon name="chevron-right" size={14} class={chevronClass} />
                  </a>
                </li>
                <li>
                  <a href="/pricing" class={footerLinkClass}>
                    <span>Pricing</span>
                    <PhosphorIcon name="chevron-right" size={14} class={chevronClass} />
                  </a>
                </li>
                <li>
                  <a href="/changelog" class={footerLinkClass}>
                    <span>Changelog</span>
                    <PhosphorIcon name="chevron-right" size={14} class={chevronClass} />
                  </a>
                </li>
                <li>
                  <a href="#download" class={footerLinkClass}>
                    <span>Download</span>
                    <PhosphorIcon name="chevron-right" size={14} class={chevronClass} />
                  </a>
                </li>
              </ul>
            </div>

            <div>
              <p class="editorial-eyebrow mb-4">Resources</p>
              <ul class="space-y-2.5">
                <li>
                  <a href="/blog" class={footerLinkClass}>
                    <span>Blog</span>
                    <PhosphorIcon name="chevron-right" size={14} class={chevronClass} />
                  </a>
                </li>
                <li>
                  <a href="/docs" class={footerLinkClass}>
                    <span>Docs</span>
                    <PhosphorIcon name="chevron-right" size={14} class={chevronClass} />
                  </a>
                </li>
                <li>
                  <a href="/press" class={footerLinkClass}>
                    <span>Press kit</span>
                    <PhosphorIcon name="chevron-right" size={14} class={chevronClass} />
                  </a>
                </li>
              </ul>
            </div>

            <div>
              <p class="editorial-eyebrow mb-4">Legal</p>
              <ul class="space-y-2.5">
                <li>
                  <a href="/privacy" class={footerLinkClass}>
                    <span>Privacy</span>
                    <PhosphorIcon name="chevron-right" size={14} class={chevronClass} />
                  </a>
                </li>
                <li>
                  <a href="/terms" class={footerLinkClass}>
                    <span>Terms</span>
                    <PhosphorIcon name="chevron-right" size={14} class={chevronClass} />
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <BejamasSeparator class="my-10" />

      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <p class="body-s ink-tertiary">
          &copy; {new Date().getFullYear()} Cardmaniacs. All rights reserved.
        </p>
        <p class="body-s ink-tertiary">Crafted for macOS, iOS & iPadOS</p>
      </div>
    </div>
  </Container>
</footer>
