<section data-testid="final-cta" class="section-gap text-center relative overflow-hidden" id="download">
  <!-- Organic backgrounds -->
  <div class="blob blob-blue w-[600px] h-[400px] top-0 left-1/4 absolute"></div>
  <div class="blob blob-peach w-[500px] h-[400px] bottom-0 right-1/3 absolute"></div>

  <div class="mx-auto max-w-[640px] px-6 relative">
    <h2 class="heading-hero text-ink mb-6" data-testid="cta-heading">
      Start reading,<br/>stop tab-hoarding.
    </h2>
    <p class="body-large text-ink-secondary mb-10 max-w-[480px] mx-auto">
      Download Cardmaniacs for macOS, iOS, or iPadOS. 
      Your calm reading desk is waiting.
    </p>

    <!-- App Store badge -->
    <a href="#download" class="inline-block" data-testid="cta-appstore-btn">
      <svg viewBox="0 0 120 40" class="h-[54px] w-auto" xmlns="http://www.w3.org/2000/svg">
        <rect width="120" height="40" rx="6" fill="#000"/>
        <text x="42" y="13" fill="#fff" font-size="5.5" font-family="-apple-system, sans-serif" font-weight="400">Download on the</text>
        <text x="42" y="27" fill="#fff" font-size="11" font-family="-apple-system, sans-serif" font-weight="600">App Store</text>
        <g transform="translate(12, 6) scale(0.56)" fill="#fff">
          <path d="M24.769 20.3a4.949 4.949 0 0 1 2.356-4.151 5.066 5.066 0 0 0-3.99-2.158c-1.68-.176-3.308 1.005-4.164 1.005-.872 0-2.19-.988-3.608-.958a5.315 5.315 0 0 0-4.473 2.728c-1.934 3.348-.491 8.269 1.361 10.976.927 1.325 2.01 2.805 3.428 2.753 1.387-.058 1.905-.885 3.58-.885 1.658 0 2.144.885 3.59.852 1.489-.025 2.426-1.332 3.32-2.669a10.962 10.962 0 0 0 1.52-3.092 4.782 4.782 0 0 1-2.92-4.4ZM22.037 12.21a4.872 4.872 0 0 0 1.115-3.49 4.957 4.957 0 0 0-3.208 1.66 4.636 4.636 0 0 0-1.144 3.36 4.1 4.1 0 0 0 3.237-1.53Z"/>
        </g>
      </svg>
    </a>

    <p class="text-ink-tertiary text-[13px] mt-5">Available on macOS, iOS, and iPadOS</p>
  </div>
</section>
