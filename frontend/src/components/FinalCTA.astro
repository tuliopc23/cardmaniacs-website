---
---

<section data-testid="final-cta" class="section-gap text-center relative overflow-hidden atmosphere-cta" id="download">
  
  <!-- Ambient blobs -->
  <div class="blob blob-blue blob-animate w-[500px] h-[400px] top-10 left-[15%] absolute"></div>
  <div class="blob blob-peach blob-animate-delay w-[400px] h-[350px] bottom-10 right-[20%] absolute"></div>
  <div class="blob blob-rose blob-animate w-[300px] h-[300px] top-1/3 right-[10%] absolute opacity-30"></div>

  <div class="mx-auto max-w-[640px] px-6 relative z-10">
    <h2 class="heading-hero text-ink mb-7" data-testid="cta-heading">
      Start reading,<br/>stop tab-hoarding.
    </h2>
    <p class="body-large text-ink-secondary mb-12 max-w-[480px] mx-auto leading-relaxed">
      Download Cardmaniacs for macOS, iOS, or iPadOS. 
      Your calm reading desk is waiting.
    </p>

    <!-- App Store badge -->
    <a href="#download" class="inline-flex items-center gap-3 bg-[#1d1d1f] text-white pl-4 pr-5 py-2.5 rounded-xl transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]" style="box-shadow: 0 0.5px 0 0 rgba(255,255,255,0.08) inset, 0 2px 6px rgba(0,0,0,0.12), 0 8px 24px rgba(0,0,0,0.15);" data-testid="cta-appstore-btn">
      <svg class="w-7 h-7 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 21.99 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 21.99C7.79 22.03 6.8 20.68 5.96 19.47C4.25 16.97 2.94 12.45 4.7 9.39C5.57 7.87 7.13 6.91 8.82 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/>
      </svg>
      <div class="flex flex-col">
        <span class="text-[10px] text-white/60 leading-none">Download on the</span>
        <span class="text-[17px] font-semibold leading-tight tracking-tight">App Store</span>
      </div>
    </a>

    <p class="text-ink-tertiary text-[13px] mt-6 font-medium">Available on macOS, iOS, and iPadOS</p>
  </div>
</section>
