---
// Drop this component once on any page that uses data-reveal attributes.
// It handles scroll-triggered reveal animations via the Motion library.
---

<script>
  import { animate, inView } from 'motion';

  function initScrollReveal() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document.querySelectorAll('[data-reveal]').forEach((el) => {
      const htmlEl = el as HTMLElement;
      if (htmlEl.dataset.revealInit) return;
      htmlEl.dataset.revealInit = '1';

      inView(
        htmlEl,
        () => {
          htmlEl.style.transform = 'translateY(24px)';
          animate(
            htmlEl,
            ({ y: [24, 0] } as any),
            ({ duration: 0.6, easing: 'ease-out' } as any)
          );
        },
        { margin: '-60px 0px -60px 0px' }
      );
    });
  }

  initScrollReveal();
  document.addEventListener('astro:after-swap', initScrollReveal);
</script>
