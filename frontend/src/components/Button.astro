---
import UIButton from './ui/Button.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
}

const { variant = 'primary', size = 'md', href, class: className = '' } = Astro.props;
---

<UIButton href={href} variant={variant} size={size} class={className}>
  <slot />
</UIButton>
