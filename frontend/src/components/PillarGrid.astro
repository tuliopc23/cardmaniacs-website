---
import SectionBlock from './SectionBlock.astro';
import BejamasCard from './ui/bejamas/Card.astro';
import PhosphorIcon from './PhosphorIcon.astro';

const pillars = [
  {
    icon: 'rss' as const,
    title: 'Feeds',
    description: 'RSS, Atom, YouTube, podcasts, Reddit, Mastodon — every syndication format in one beautiful card-based stream.',
    screenshot: '/images/Cardmaniacs-mac - 2.png',
  },
  {
    icon: 'bookmark-simple' as const,
    title: 'Read Later',
    description: 'Quick capture from any app, full-text parsing, specialized renderers for complex sites. Your queue, under control.',
    screenshot: '/images/Cardmaniacs-mac - 5.png',
  },
  {
    icon: 'bookmarks' as const,
    title: 'Bookmarks',
    description: 'Tags, smart folders, full-text search across everything. Import PDFs, EPUB & Markdown. Your reference library.',
    screenshot: '/images/Cardmaniacs-mac - 7.png',
  },
];
---

<SectionBlock label="Three pillars" heading="One app for your entire reading workflow.">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {pillars.map((pillar) => (
      <a href="/features" class="group block rounded-[var(--radius-card)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring-focus)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface-base)]">
        <BejamasCard padding="none" hover class="h-full overflow-hidden">
          <div class="relative overflow-hidden border-b border-[var(--border-subtle)] bg-[radial-gradient(900px_260px_at_25%_0%,color-mix(in_oklab,var(--cm-blue)_18%,transparent)_0%,transparent_60%),linear-gradient(to_bottom,color-mix(in_oklab,var(--surface-overlay)_45%,transparent),transparent)] h-[172px] [border-top-left-radius:var(--radius-card)] [border-top-right-radius:var(--radius-card)]">
            <img
              src={pillar.screenshot}
              alt={`Cardmaniacs — ${pillar.title}`}
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover opacity-[0.92] transition-transform duration-500 group-hover:scale-[1.02]"
            />
            <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_bottom,rgba(0,0,0,0.08),transparent_40%,rgba(0,0,0,0.12))] dark:bg-[linear-gradient(to_bottom,rgba(0,0,0,0.25),transparent_45%,rgba(0,0,0,0.35))]"></div>
            <div class="absolute left-4 top-4 flex items-center gap-2">
              <span class="inline-flex items-center justify-center size-9 [border-radius:var(--radius-pill)] bg-[color-mix(in_oklab,var(--surface-elevated)_55%,transparent)] ring-1 ring-black/5 dark:ring-white/10 backdrop-blur-md ink-primary shadow-[var(--shadow-pill)]">
                <PhosphorIcon name={pillar.icon} size={22} />
              </span>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 border border-[var(--border-accent)] leading-none [border-radius:var(--radius-pill)] text-[11px] font-display font-semibold bg-[var(--cm-blue-subtle)] text-[var(--cm-blue-ink)] shadow-[var(--shadow-pill)]">
                {pillar.title}
              </span>
            </div>
          </div>

          <div class="p-6">
            <h3 class="subheading ink-primary mb-2 text-balance">{pillar.title}</h3>
            <p class="body-s ink-secondary leading-relaxed text-pretty">
              {pillar.description}
            </p>
            <p class="mt-4 inline-flex items-center gap-1.5 text-[13px] font-display font-semibold ink-accent">
              See on Features
              <PhosphorIcon name="chevron-right" size={14} class="transition-transform group-hover:translate-x-0.5" />
            </p>
          </div>
        </BejamasCard>
      </a>
    ))}
  </div>
</SectionBlock>
