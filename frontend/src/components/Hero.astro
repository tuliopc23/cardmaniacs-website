---
---

<section data-testid="hero-section" class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  
  <!-- Organic background shapes -->
  <div class="blob blob-blue w-[500px] h-[500px] -top-48 -right-32 absolute"></div>
  <div class="blob blob-lavender w-[400px] h-[400px] top-20 -left-48 absolute"></div>

  <div class="mx-auto max-w-[1120px] px-6 relative">
    
    <!-- Text content — left aligned -->
    <div class="max-w-[680px]">
      <p class="label text-accent mb-5" data-testid="hero-label">Feeds &middot; Read Later &middot; Bookmarks</p>
      
      <h1 class="heading-hero text-ink mb-6" data-testid="hero-heading">
        Your calm reading desk,<br/>
        all in one place.
      </h1>

      <p class="body-large text-ink-secondary max-w-[520px] mb-10" data-testid="hero-description">
        A native Apple app that unifies RSS feeds, Read Later, and Bookmarks into one beautifully crafted experience. Built for people who collect, save, and actually finish what they read.
      </p>

      <div class="flex flex-col sm:flex-row items-start gap-4" data-testid="hero-ctas">
        <!-- App Store badge -->
        <a href="#download" data-testid="hero-appstore-btn">
          <svg viewBox="0 0 120 40" class="h-[54px] w-auto" xmlns="http://www.w3.org/2000/svg">
            <rect width="120" height="40" rx="6" fill="#000"/>
            <text x="42" y="13" fill="#fff" font-size="5.5" font-family="-apple-system, sans-serif" font-weight="400">Download on the</text>
            <text x="42" y="27" fill="#fff" font-size="11" font-family="-apple-system, sans-serif" font-weight="600">App Store</text>
            <g transform="translate(12, 6) scale(0.56)" fill="#fff">
              <path d="M24.769 20.3a4.949 4.949 0 0 1 2.356-4.151 5.066 5.066 0 0 0-3.99-2.158c-1.68-.176-3.308 1.005-4.164 1.005-.872 0-2.19-.988-3.608-.958a5.315 5.315 0 0 0-4.473 2.728c-1.934 3.348-.491 8.269 1.361 10.976.927 1.325 2.01 2.805 3.428 2.753 1.387-.058 1.905-.885 3.58-.885 1.658 0 2.144.885 3.59.852 1.489-.025 2.426-1.332 3.32-2.669a10.962 10.962 0 0 0 1.52-3.092 4.782 4.782 0 0 1-2.92-4.4ZM22.037 12.21a4.872 4.872 0 0 0 1.115-3.49 4.957 4.957 0 0 0-3.208 1.66 4.636 4.636 0 0 0-1.144 3.36 4.1 4.1 0 0 0 3.237-1.53Z"/>
            </g>
          </svg>
        </a>

        <a 
          href="/features" 
          class="text-accent text-[15px] font-medium flex items-center gap-1.5 py-3.5 group"
          data-testid="hero-features-link"
        >
          Explore features
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Hero screenshot composition -->
    <div class="mt-16 md:mt-20 relative" data-testid="hero-screenshot">
      <div class="macbook-frame max-w-[900px] mx-auto relative z-10">
        <img 
          src="/images/Cardmaniacs-mac - 1.png" 
          alt="Cardmaniacs on macOS — Card-based reading interface" 
          loading="eager"
          class="w-full"
        />
      </div>

      <!-- Overlapping secondary screenshot -->
      <div class="hidden md:block absolute -right-4 bottom-8 w-[380px] z-20 macbook-frame rotate-1 opacity-95">
        <img 
          src="/images/Cardmaniacs-mac - 3.png" 
          alt="Cardmaniacs article view" 
          loading="eager"
          class="w-full"
        />
      </div>

      <!-- Subtle organic form behind -->
      <div class="blob blob-peach w-[600px] h-[400px] -bottom-32 left-1/4 absolute -z-10"></div>
    </div>
  </div>
</section>
