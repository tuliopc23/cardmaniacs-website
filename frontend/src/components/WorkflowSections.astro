---
const workflows = [
  {
    label: 'Feeds',
    title: 'All your sources,\none reading stream.',
    description: 'RSS, Atom, YouTube, podcasts, Reddit, Mastodon — every syndication format in a single, beautiful card-based feed. No more tab hoarding.',
    screenshot: '/images/Cardmaniacs-mac - 2.png',
    align: 'left' as const,
    blob: 'blob-blue',
  },
  {
    label: 'Read Later',
    title: 'Save anything.\nFinish everything.',
    description: 'Quick capture from any app, full-text parsing, specialized renderers for GitHub READMEs, Wikipedia, and JS-heavy sites. Your reading queue, finally under control.',
    screenshot: '/images/Cardmaniacs-mac - 5.png',
    align: 'right' as const,
    blob: 'blob-lavender',
  },
  {
    label: 'Bookmarks',
    title: 'Organize once,\nfind it forever.',
    description: 'Tags, smart folders, full-text search across everything you\'ve saved. Import PDFs, EPUB, and Markdown. Your personal reference library, always at hand.',
    screenshot: '/images/Cardmaniacs-mac - 7.png',
    align: 'left' as const,
    blob: 'blob-mint',
  },
];
---

<section data-testid="workflow-sections" class="section-gap">
  <div class="mx-auto max-w-[1120px] px-6 space-y-36 md:space-y-52">
    {workflows.map((w, i) => (
      <div 
        class="relative"
        data-testid={`workflow-${i}`}
      >
        <!-- Ambient blob behind the screenshot -->
        <div class:list={[
          "blob w-[400px] h-[400px] absolute -z-10 blob-animate",
          w.blob,
          w.align === 'left' ? 'right-[-80px] top-[-40px]' : 'left-[-80px] top-[-40px]'
        ]}></div>

        <div class:list={[
          "grid grid-cols-1 md:grid-cols-12 gap-14 md:gap-20 items-center",
        ]}>
          <!-- Text side -->
          <div class:list={[
            "md:col-span-5",
            w.align === 'right' ? 'md:col-start-8 md:order-2' : ''
          ]}>
            <p class="label text-accent mb-5 tracking-[0.08em]">{w.label}</p>
            <h2 class="heading-display text-ink mb-6 whitespace-pre-line">{w.title}</h2>
            <p class="body-large text-ink-secondary leading-relaxed">{w.description}</p>
          </div>

          <!-- Screenshot side -->
          <div class:list={[
            "md:col-span-7",
            w.align === 'right' ? 'md:col-start-1 md:row-start-1 md:order-1' : ''
          ]}>
            <div class="macbook-frame">
              <div class="macbook-frame-specular"></div>
              <img 
                src={w.screenshot} 
                alt={`Cardmaniacs — ${w.label}`} 
                loading="lazy"
                class="w-full"
              />
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
