---
const workflows = [
  {
    label: 'Feeds',
    title: 'All your sources,\none reading stream.',
    description: 'RSS, Atom, YouTube, podcasts, Reddit, Mastodon — every syndication format in a single, beautiful card-based feed. No more tab hoarding.',
    screenshot: '/images/Cardmaniacs-mac - 2.png',
    align: 'left' as const,
  },
  {
    label: 'Read Later',
    title: 'Save anything.\nFinish everything.',
    description: 'Quick capture from any app, full-text parsing, specialized renderers for GitHub READMEs, Wikipedia, and JS-heavy sites. Your reading queue, finally under control.',
    screenshot: '/images/Cardmaniacs-mac - 5.png',
    align: 'right' as const,
  },
  {
    label: 'Bookmarks',
    title: 'Organize once,\nfind it forever.',
    description: 'Tags, smart folders, full-text search across everything you\'ve saved. Import PDFs, EPUB, and Markdown. Your personal reference library, always at hand.',
    screenshot: '/images/Cardmaniacs-mac - 7.png',
    align: 'left' as const,
  },
];
---

<section data-testid="workflow-sections" class="section-gap">
  <div class="mx-auto max-w-[1120px] px-6 space-y-32 md:space-y-44">
    {workflows.map((w, i) => (
      <div 
        class:list={[
          "grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-center",
          w.align === 'right' ? 'md:direction-rtl' : ''
        ]}
        data-testid={`workflow-${i}`}
      >
        <!-- Text side -->
        <div class:list={[
          "md:col-span-5",
          w.align === 'right' ? 'md:col-start-8 md:direction-ltr' : ''
        ]}>
          <p class="label text-accent mb-4">{w.label}</p>
          <h2 class="heading-display text-ink mb-5 whitespace-pre-line">{w.title}</h2>
          <p class="body-large text-ink-secondary">{w.description}</p>
        </div>

        <!-- Screenshot side -->
        <div class:list={[
          "md:col-span-7 relative",
          w.align === 'right' ? 'md:col-start-1 md:row-start-1 md:direction-ltr' : ''
        ]}>
          <div class="macbook-frame">
            <img 
              src={w.screenshot} 
              alt={`Cardmaniacs — ${w.label}`} 
              loading="lazy"
              class="w-full"
            />
          </div>
          
          <!-- Subtle organic bg -->
          <div class:list={[
            "blob w-[350px] h-[350px] absolute -z-10",
            i % 2 === 0 ? 'blob-blue -bottom-20 -right-20' : 'blob-mint -bottom-20 -left-20'
          ]}></div>
        </div>
      </div>
    ))}
  </div>
</section>
