---
const proofs = [
  { icon: 'apple', label: 'macOS, iOS, iPadOS' },
  { icon: 'offline', label: 'Offline reading' },
  { icon: 'rss', label: 'RSS & Atom feeds' },
  { icon: 'bookmark', label: 'Read Later' },
  { icon: 'doc', label: 'PDF, EPUB, Markdown' },
  { icon: 'widget', label: 'Widgets & Shortcuts' },
];
---

<section data-testid="proof-strip" class="py-12 border-y border-border-light bg-surface-raised/50">
  <div class="mx-auto max-w-[1120px] px-6">
    <div class="flex flex-wrap justify-start gap-x-10 gap-y-4">
      {proofs.map((item, i) => (
        <div class="proof-item" data-testid={`proof-item-${i}`}>
          <svg class="w-4 h-4 text-ink-tertiary flex-shrink-0" viewBox="0 0 16 16" fill="currentColor">
            {item.icon === 'apple' && <path d="M11.182 1.5C10.29 1.5 9.47 1.96 8.89 2.71L8 3.91L7.11 2.71C6.53 1.96 5.71 1.5 4.82 1.5C3.39 1.5 2.25 2.74 2.25 4.29C2.25 7.63 8 10.75 8 10.75C8 10.75 13.75 7.63 13.75 4.29C13.75 2.74 12.61 1.5 11.18 1.5Z"/>}
            {item.icon === 'offline' && <path d="M8 1.5a6.5 6.5 0 100 13 6.5 6.5 0 000-13zm-.5 3.5a.5.5 0 011 0v3.5a.5.5 0 01-.146.354l-2 2a.5.5 0 01-.708-.708L7.5 8.293V5z"/>}
            {item.icon === 'rss' && <path d="M2 3a1 1 0 011-1 10 10 0 0110 10 1 1 0 11-2 0 8 8 0 00-8-8 1 1 0 01-1-1zm1 3a1 1 0 100 2 5 5 0 015 5 1 1 0 102 0 7 7 0 00-7-7zm0 5a2 2 0 110 4 2 2 0 010-4z"/>}
            {item.icon === 'bookmark' && <path d="M4 2.5A1.5 1.5 0 015.5 1h5A1.5 1.5 0 0112 2.5v11a.5.5 0 01-.765.424L8 11.56l-3.235 2.364A.5.5 0 014 13.5v-11z"/>}
            {item.icon === 'doc' && <path d="M4 1.5A1.5 1.5 0 015.5 0h3.379a1.5 1.5 0 011.06.44l2.122 2.12A1.5 1.5 0 0112.5 3.622V14.5a1.5 1.5 0 01-1.5 1.5h-5.5A1.5 1.5 0 014 14.5v-13zM5.5 1a.5.5 0 00-.5.5v13a.5.5 0 00.5.5H11a.5.5 0 00.5-.5V4H9.5A1.5 1.5 0 018 2.5V1H5.5z"/>}
            {item.icon === 'widget' && <path d="M2.5 1A1.5 1.5 0 001 2.5v4A1.5 1.5 0 002.5 8h4A1.5 1.5 0 008 6.5v-4A1.5 1.5 0 006.5 1h-4zm0 8A1.5 1.5 0 001 10.5v3A1.5 1.5 0 002.5 15h3A1.5 1.5 0 007 13.5v-3A1.5 1.5 0 005.5 9h-3zm7-8A1.5 1.5 0 008 2.5v3A1.5 1.5 0 009.5 7h3A1.5 1.5 0 0014 5.5v-3A1.5 1.5 0 0012.5 1h-3zm0 8A1.5 1.5 0 008 10.5v3a1.5 1.5 0 001.5 1.5h3a1.5 1.5 0 001.5-1.5v-3A1.5 1.5 0 0012.5 9h-3z"/>}
          </svg>
          <span>{item.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
