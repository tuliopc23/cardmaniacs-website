---
/**
 * Bejamas-style button / link — rounded control, CM accent.
 */
interface Props {
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md";
  href?: string;
  class?: string;
}

const { variant = "primary", size = "md", href, class: className = "" } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-display font-semibold transition-all duration-200 rounded-[var(--radius-md)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring-focus)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface-base)] active:scale-[0.985] motion-reduce:active:scale-100";

const sizes = {
  sm: "text-[13px] px-4 py-2 min-h-[40px]",
  md: "text-[14px] px-5 py-2.5 min-h-[44px]",
} as const;

const variants = {
  primary:
    "text-white bg-[var(--accent)] shadow-[var(--shadow-button)] hover:bg-[var(--accent-hover)] hover:-translate-y-px",
  secondary:
    "text-[var(--ink-primary)] bg-[color-mix(in_oklab,var(--surface-overlay)_88%,transparent)] border border-[var(--border-strong)] hover:bg-[var(--surface-overlay)]",
  ghost: "text-[var(--ink-secondary)] hover:text-[var(--ink-primary)] hover:bg-[var(--accent-subtle)] border border-transparent",
} as const;

const cls = [base, sizes[size], variants[variant], className];
---

{
  href ? (
    <a href={href} class:list={cls}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={cls}>
      <slot />
    </button>
  )
}
