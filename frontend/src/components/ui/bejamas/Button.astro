---
/**
 * Bejamas-style button / link — pill + liquid glass accent (CM tokens).
 */
interface Props {
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md";
  href?: string;
  class?: string;
}

const { variant = "primary", size = "md", href, class: className = "" } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-display font-semibold transition-[transform,opacity,box-shadow,background-color,border-color] duration-200 [border-radius:var(--radius-pill)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring-focus)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface-base)] active:scale-[0.985] motion-reduce:active:scale-100";

const sizes = {
  sm: "text-[13px] px-4 py-2 min-h-[40px]",
  md: "text-[14px] px-5 py-2.5 min-h-[44px]",
} as const;

const variants = {
  primary:
    "cm-btn-liquid text-white hover:-translate-y-px active:translate-y-0",
  secondary:
    "cm-btn-liquid cm-btn-liquid--soft text-white hover:-translate-y-px active:translate-y-0",
  ghost: "text-[var(--ink-secondary)] hover:text-[var(--ink-primary)] hover:bg-[var(--accent-subtle)] border border-transparent",
} as const;

const cls = [base, sizes[size], variants[variant], className];
---

{
  href ? (
    <a href={href} class:list={cls}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={cls}>
      <slot />
    </button>
  )
}
