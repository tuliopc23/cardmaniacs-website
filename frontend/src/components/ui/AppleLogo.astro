---
import { APPLE_LOGO_PATH } from "../../lib/apple-logo";

interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className = "" } = Astro.props;
---

<svg
  class:list={["shrink-0", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
>
  <path d={APPLE_LOGO_PATH} />
</svg>
