---
interface Props {
  variant?: "default" | "accent" | "muted";
  class?: string;
}

const { variant = "default", class: className = "" } = Astro.props;

const variants = {
  default:
    "bg-[color-mix(in_oklab,var(--surface-overlay)_72%,transparent)] text-[var(--ink-secondary)] border-[var(--border-subtle)] shadow-[var(--shadow-pill)]",
  accent:
    "bg-[var(--cm-blue-subtle)] text-[var(--cm-blue-ink)] border-[var(--border-accent)] shadow-[var(--shadow-pill)]",
  muted: "bg-transparent text-[var(--ink-tertiary)] border-[var(--border-subtle)] shadow-none",
} as const;
---

<span
  class:list={[
    "inline-flex items-center gap-1 px-2.5 py-0.5 border leading-none [border-radius:var(--radius-pill)] text-[11px] font-display font-semibold tracking-wide backdrop-blur-[2px]",
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
