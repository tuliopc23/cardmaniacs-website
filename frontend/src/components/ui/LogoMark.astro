---
interface Props {
  size?: "sm" | "lg";
  class?: string;
}

const { size = "sm", class: className = "" } = Astro.props;

const sizes = {
  sm: "size-8 rounded-[12px]",
  lg: "size-[80px] sm:size-[96px] md:size-[112px] rounded-[24px] md:rounded-[28px] shadow-[var(--shadow-soft)]",
} as const;

const scales = {
  sm: "scale-105",
  lg: "scale-[1.06]",
} as const;
---

<span
  class:list={["logo-mark relative shrink-0 overflow-hidden", sizes[size], className]}
  aria-hidden="true"
>
  <img
    src="/images/Cardmaniacs-icon-white.png"
    alt=""
    class:list={["size-full object-cover", scales[size]]}
    width={size === "lg" ? 112 : 32}
    height={size === "lg" ? 112 : 32}
    loading={size === "lg" ? "eager" : "lazy"}
  />
</span>
