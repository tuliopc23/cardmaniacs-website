---
interface Props {
  variant?: "paper" | "elevated" | "glass" | "inset";
  radius?: "card" | "panel" | "pill" | "hero";
  interactive?: boolean;
  id?: string;
  href?: string;
  as?: "div" | "section" | "article";
  class?: string;
}

const {
  variant = "elevated",
  radius = "card",
  interactive = false,
  id,
  href,
  as,
  class: className = "",
} = Astro.props;

const tag = as ?? "div";

const radii: Record<NonNullable<Props["radius"]>, string> = {
  card: "[border-radius:var(--radius-card)]",
  panel: "[border-radius:var(--radius-panel)]",
  pill: "[border-radius:var(--radius-pill)]",
  hero: "[border-radius:var(--radius-hero)]",
};

const base = "relative overflow-hidden border transition-all duration-300";

const variants: Record<NonNullable<Props["variant"]>, string> = {
  paper: "bg-[var(--surface-base)] border-[var(--border-subtle)]",
  elevated:
    "bg-[var(--surface-elevated)] border-[var(--border-subtle)] shadow-[var(--shadow-card)]",
  glass:
    "bg-[var(--surface-glass)] border-[var(--border-glass)] shadow-[var(--shadow-glass)] backdrop-blur-[var(--blur-glass)] backdrop-saturate-[var(--sat-glass)] supports-[backdrop-filter]:bg-[var(--surface-glass)]",
  inset: "bg-[var(--surface-inset)] border-[var(--border-subtle)]",
};

const interaction = interactive
  ? "hover:-translate-y-0.5 hover:shadow-[var(--shadow-card-hover)] active:translate-y-0 motion-reduce:hover:translate-y-0"
  : "";
---

{href ? (
  <a
    id={id}
    href={href}
    class:list={[
      base,
      radii[radius],
      variants[variant],
      interaction,
      interactive ? "cursor-pointer" : "",
      className,
    ]}
  >
    <div class="pointer-events-none absolute inset-0 opacity-70 [background:radial-gradient(1200px_600px_at_30%_0%,color-mix(in_oklab,var(--cm-blue)_10%,transparent)_0%,transparent_55%)]"></div>
    <div class="relative">
      <slot />
    </div>
  </a>
) : (
  tag === "section" ? (
    <section
      id={id}
      class:list={[
        base,
        radii[radius],
        variants[variant],
        interaction,
        interactive ? "cursor-pointer" : "",
        className,
      ]}
    >
      <div class="pointer-events-none absolute inset-0 opacity-70 [background:radial-gradient(1200px_600px_at_30%_0%,color-mix(in_oklab,var(--cm-blue)_10%,transparent)_0%,transparent_55%)]"></div>
      <div class="relative">
        <slot />
      </div>
    </section>
  ) : tag === "article" ? (
    <article
      id={id}
      class:list={[
        base,
        radii[radius],
        variants[variant],
        interaction,
        interactive ? "cursor-pointer" : "",
        className,
      ]}
    >
      <div class="pointer-events-none absolute inset-0 opacity-70 [background:radial-gradient(1200px_600px_at_30%_0%,color-mix(in_oklab,var(--cm-blue)_10%,transparent)_0%,transparent_55%)]"></div>
      <div class="relative">
        <slot />
      </div>
    </article>
  ) : (
    <div
      id={id}
      class:list={[
        base,
        radii[radius],
        variants[variant],
        interaction,
        interactive ? "cursor-pointer" : "",
        className,
      ]}
    >
      <div class="pointer-events-none absolute inset-0 opacity-70 [background:radial-gradient(1200px_600px_at_30%_0%,color-mix(in_oklab,var(--cm-blue)_10%,transparent)_0%,transparent_55%)]"></div>
      <div class="relative">
        <slot />
      </div>
    </div>
  )
)}

