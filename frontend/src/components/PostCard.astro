---
interface Props {
  href: string;
  title: string;
  summary?: string;
  date?: string;
}

const { href, title, summary, date } = Astro.props;
---

<a
  href={href}
  class="group block rounded-[var(--radius-lg)] surface-raised border border-[var(--border-subtle)] shadow-[var(--shadow-card)] transition-all duration-300 hover:shadow-[var(--shadow-card-hover)] hover:-translate-y-0.5 overflow-hidden"
>
  <div class="p-6">
    {date && (
      <time class="caption ink-tertiary block mb-2" datetime={date}>
        {new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
      </time>
    )}
    <h2 class="subheading ink-primary mb-2 group-hover:ink-accent transition-colors duration-200">{title}</h2>
    {summary && <p class="body-s ink-secondary line-clamp-3 leading-relaxed">{summary}</p>}
    <div class="mt-4 flex items-center gap-1 ink-accent text-[13px] font-display font-medium">
      Read article
      <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </div>
</a>
