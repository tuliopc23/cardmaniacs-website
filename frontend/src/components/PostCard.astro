---
import ArticleCard from './site/ArticleCard.astro';

interface Props {
  href: string;
  title: string;
  summary?: string;
  date?: string;
  cover?: string;
  featured?: boolean;
  tags?: string;
}

const { href, title, summary, date, cover, featured, tags } = Astro.props;
---

<ArticleCard href={href} title={title} summary={summary} date={date} cover={cover} featured={featured} tags={tags} />
