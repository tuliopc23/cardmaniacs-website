---
import DockIconChrome from "./ui/DockIconChrome.astro";
import LucideIcon from "./LucideIcon.astro";
import { downloadCta } from "../lib/site-cta";

const href = downloadCta.isAvailable ? downloadCta.href : "/#get-the-app";
const label = downloadCta.isAvailable ? "Download on the App Store" : "Get the App";
const external = downloadCta.isAvailable;
---

<DockIconChrome>
  <a
    id="cm-app-store-dock-btn"
    href={href}
    class="relative z-[1] flex size-full items-center justify-center rounded-full outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring-focus)] focus-visible:ring-inset active:scale-95 transition-transform duration-200 motion-reduce:transition-none"
    aria-label={label}
    {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
  >
    {
      downloadCta.isAvailable ? (
        <svg class="size-6 ink-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 21.99 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 21.99C7.79 22.03 6.8 20.68 5.96 19.47C4.25 16.97 2.94 12.45 4.7 9.39C5.57 7.87 7.13 6.91 8.82 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z" />
        </svg>
      ) : (
        <LucideIcon name="download" size={22} weight="bold" class="ink-primary" />
      )
    }
  </a>
</DockIconChrome>

<script>
  function initAppStoreDockButton() {
    window.__cmAppDockAbort?.abort();
    const ac = new AbortController();
    window.__cmAppDockAbort = ac;
    const { signal } = ac;

    const link = document.getElementById("cm-app-store-dock-btn");
    if (!(link instanceof HTMLAnchorElement)) return;

    link.addEventListener(
      "click",
      (e) => {
        const href = link.getAttribute("href") ?? "";
        if (href.startsWith("http")) return;

        const onPageTarget = document.getElementById("get-the-app");
        if (!onPageTarget) return;

        e.preventDefault();
        onPageTarget.scrollIntoView({ behavior: "smooth", block: "center" });
        history.pushState(null, "", "#get-the-app");
      },
      { signal }
    );
  }

  initAppStoreDockButton();
  document.addEventListener("astro:after-swap", initAppStoreDockButton);
</script>
