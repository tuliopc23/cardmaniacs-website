---
import Container from './Container.astro';
import SectionHeader from './ui/SectionHeader.astro';

interface Props {
  label?: string;
  heading?: string;
  icon?: string;
  class?: string;
  id?: string;
  as?: keyof HTMLElementTagNameMap;
  inset?: boolean;
  reveal?: boolean;
}

const { label, heading, icon, class: className = '', id, as: Tag = 'section', inset = false, reveal = false } = Astro.props;
---

<Tag
  id={id}
  data-reveal={reveal ? true : undefined}
  class:list={['py-20 md:py-28 lg:py-32', inset ? 'section-band' : '', className]}
>
  <Container>
    {(label || heading) && (
      <div class="mb-12 md:mb-16">
        <SectionHeader eyebrow={label} heading={heading} icon={icon} iconPlacement="eyebrow" />
      </div>
    )}
    <slot />
  </Container>
</Tag>
