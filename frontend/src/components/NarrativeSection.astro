---
import Container from './Container.astro';
import ProductShowcase from './ProductShowcase.astro';
import SectionHeader from './ui/SectionHeader.astro';

interface Props {
  label: string;
  heading: string;
  description: string;
  screenshot: string;
  screenshotAlt: string;
  reverse?: boolean;
  icon?: string;
  inset?: boolean;
}

const { label, heading, description, screenshot, screenshotAlt, reverse = false, inset = false, icon } = Astro.props;
---

<section class:list={['py-20 md:py-28 lg:py-32', inset ? 'section-band' : '']}>
  <Container>
    <div class:list={[
      'grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center',
    ]}>
      <div class:list={[
        'lg:col-span-4',
        reverse ? 'lg:col-start-9 lg:order-2' : '',
      ]}>
        <SectionHeader
          eyebrow={label}
          heading={heading}
          description={description}
          icon={icon}
          iconPlacement="eyebrow"
          headingClass="type-section-title ink-primary text-balance"
        />
      </div>

      <div class:list={[
        'lg:col-span-8',
        reverse ? 'lg:col-start-1 lg:row-start-1 lg:order-1' : '',
      ]} data-reveal>
        <ProductShowcase
          src={screenshot}
          alt={screenshotAlt}
        />
      </div>
    </div>
  </Container>
</section>
