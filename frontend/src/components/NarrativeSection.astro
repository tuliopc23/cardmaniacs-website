---
import Container from './Container.astro';
import ProductShowcase from './ProductShowcase.astro';

interface Props {
  label: string;
  heading: string;
  description: string;
  screenshot: string;
  screenshotAlt: string;
  reverse?: boolean;
  /** Subtle vertical rhythm band — not full grey inset slab */
  inset?: boolean;
}

const { label, heading, description, screenshot, screenshotAlt, reverse = false, inset = false } = Astro.props;
---

<section class:list={['py-20 md:py-28 lg:py-32', inset ? 'section-band' : '']}>
  <Container>
    <div class:list={[
      'grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center',
    ]}>
      <div class:list={[
        'lg:col-span-4',
        reverse ? 'lg:col-start-9 lg:order-2' : '',
      ]}>
        <p class="editorial-eyebrow editorial-eyebrow-accent mb-3">{label}</p>
        <h2 class="type-section-title ink-primary mb-5">{heading}</h2>
        <p class="type-lede measure-tight">{description}</p>
      </div>

      <div class:list={[
        'lg:col-span-8',
        reverse ? 'lg:col-start-1 lg:row-start-1 lg:order-1' : '',
      ]} data-reveal>
        <ProductShowcase
          src={screenshot}
          alt={screenshotAlt}
        />
      </div>
    </div>
  </Container>
</section>
