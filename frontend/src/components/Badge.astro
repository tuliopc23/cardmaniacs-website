---
interface Props {
  variant?: 'feature' | 'fix' | 'improvement' | 'neutral';
  class?: string;
}

const { variant = 'neutral', class: className = '' } = Astro.props;

const variants = {
  feature: 'bg-[var(--status-feature-bg)] text-[var(--status-feature-fg)]',
  fix: 'bg-[var(--status-fix-bg)] text-[var(--status-fix-fg)]',
  improvement: 'bg-[var(--status-improvement-bg)] text-[var(--status-improvement-fg)]',
  neutral: 'bg-[var(--surface-overlay)] ink-tertiary',
};
---

<span
  class:list={[
    'inline-flex items-center px-2 py-0.5 rounded-[var(--radius-sm)] text-[11px] font-display font-semibold leading-none',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
