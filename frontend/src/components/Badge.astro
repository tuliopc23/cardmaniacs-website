---
interface Props {
  variant?: 'feature' | 'fix' | 'improvement' | 'neutral';
  class?: string;
}

const { variant = 'neutral', class: className = '' } = Astro.props;

const variants = {
  feature: 'badge--feature',
  fix: 'badge--fix',
  improvement: 'badge--improvement',
  neutral: 'bg-[var(--surface-overlay)] ink-tertiary',
};
---

<span
  class:list={[
    'inline-flex items-center px-2 py-0.5 rounded-[var(--radius-sm)] text-[11px] font-display font-semibold leading-none',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>

<style>
  .badge--feature { background: rgba(16, 185, 129, 0.1); color: #059669; }
  .badge--fix { background: rgba(239, 68, 68, 0.1); color: #dc2626; }
  .badge--improvement { background: rgba(245, 158, 11, 0.1); color: #d97706; }
  [data-theme="dark"] .badge--feature { color: #34d399; }
  [data-theme="dark"] .badge--fix { color: #f87171; }
  [data-theme="dark"] .badge--improvement { color: #fbbf24; }
</style>
