---
import Surface from "../ui/Surface.astro";
import Pill from "../Pill.astro";
import LucideIcon from "../LucideIcon.astro";

interface Props {
  href: string;
  title: string;
  summary?: string;
  date?: string;
  eyebrow?: string;
  cover?: string;
  featured?: boolean;
  tags?: string;
  class?: string;
}

const { href, title, summary, date, eyebrow, cover, featured = false, tags, class: className = "" } = Astro.props;

const tagList = (tags ?? "")
  .split(",")
  .map((t) => t.trim())
  .filter(Boolean)
  .slice(0, 2);

const formattedDate =
  date &&
  new Date(date).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<Surface
  href={href}
  variant="elevated"
  interactive
  class:list={[
    "group cm-card-lift flex w-full flex-col p-0",
    featured && "ring-1 ring-[var(--border-accent)] shadow-[var(--shadow-soft)]",
    className,
  ]}
>
  <div
    class:list={[
      "relative w-full shrink-0 overflow-hidden aspect-[16/10]",
      featured ? "max-h-[220px] md:max-h-[280px]" : "max-h-[200px] md:max-h-[220px]",
      "[border-top-left-radius:var(--radius-card)] [border-top-right-radius:var(--radius-card)]",
      "border-b border-[var(--border-subtle)]",
      "bg-[radial-gradient(900px_260px_at_20%_0%,var(--accent-atmo-card-primary)_0%,transparent_60%),radial-gradient(900px_260px_at_70%_0%,var(--accent-atmo-card-secondary)_0%,transparent_60%),linear-gradient(to_bottom,color-mix(in_oklab,var(--surface-overlay)_45%,transparent),transparent)]",
    ]}
  >
    {cover ? (
      <img
        src={cover}
        alt=""
        width={640}
        height={400}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover object-center opacity-[0.92]"
      />
    ) : null}

    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_bottom,rgba(0,0,0,0.08),transparent_38%,rgba(0,0,0,0.12))] dark:bg-[linear-gradient(to_bottom,rgba(0,0,0,0.25),transparent_45%,rgba(0,0,0,0.35))]"></div>

    <div class="absolute left-4 right-4 top-4 flex flex-wrap items-center gap-2">
      {featured ? (
        <Pill variant="accent" class="gap-1">
          <LucideIcon name="sparkles" size={11} />
          Featured
        </Pill>
      ) : (
        <Pill variant="accent" class="gap-1">
          <LucideIcon name="notebook-pen" size={11} />
          Notes
        </Pill>
      )}
      {tagList.map((t) => (
        <Pill variant="muted" class="gap-1">
          <LucideIcon name="tag" size={11} />
          {t}
        </Pill>
      ))}
    </div>
  </div>

  <div class="flex min-w-0 flex-1 flex-col p-5 md:p-6">
    {formattedDate && (
      <p class="type-card-eyebrow type-card-eyebrow-accent mb-3 inline-flex items-center gap-1.5">
        <LucideIcon name="calendar-days" size={13} />
        <time datetime={date}>{formattedDate}</time>
      </p>
    )}

    {eyebrow && (
      <p class="type-card-eyebrow type-card-eyebrow-accent mb-2 inline-flex items-center gap-1.5">
        <LucideIcon name="sparkles" size={13} />
        {eyebrow}
      </p>
    )}

    <h2 class="subheading ink-primary text-balance mb-2 text-[1.125rem] md:text-[1.2rem]">{title}</h2>

    {summary && (
      <p class="body-s ink-secondary leading-relaxed text-pretty line-clamp-3">{summary}</p>
    )}

    <div class="mt-5 flex items-center gap-2">
      <span class="text-[13px] font-display font-semibold ink-accent">Read article</span>
      <span class="inline-flex items-center justify-center size-6 [border-radius:var(--radius-pill)] bg-[var(--cm-blue-subtle)] text-[var(--cm-blue-ink)] transition-transform duration-200 group-hover:translate-x-0.5">
        <LucideIcon name="arrow-up-right" size={15} />
      </span>
    </div>
  </div>
</Surface>
