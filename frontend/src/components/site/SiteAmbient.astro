---
/** Site-wide liquid-glass ambient backdrop (blobs, sheen, depth, optical film). */
---

<div class="cm-ambient" aria-hidden="true">
  <div class="cm-ambient__base"></div>
  <div class="cm-ambient__blob cm-ambient__blob--1"></div>
  <div class="cm-ambient__blob cm-ambient__blob--2"></div>
  <div class="cm-ambient__blob cm-ambient__blob--3"></div>
  <div class="cm-ambient__blob cm-ambient__blob--4"></div>
  <div class="cm-ambient__sheen"></div>
  <div class="cm-ambient__depth"></div>
  <div class="cm-ambient__film"></div>
</div>
