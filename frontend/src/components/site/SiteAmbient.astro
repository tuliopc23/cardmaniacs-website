---
/** Site-wide frosted-glass ambient backdrop (haze, bloom, frost veil). */
---

<div class="cm-ambient" aria-hidden="true">
  <div class="cm-ambient__base"></div>
  <div class="cm-ambient__haze"></div>
  <div class="cm-ambient__bloom cm-ambient__bloom--a"></div>
  <div class="cm-ambient__bloom cm-ambient__bloom--b"></div>
  <div class="cm-ambient__frost"></div>
  <div class="cm-ambient__glint"></div>
  <div class="cm-ambient__film"></div>
</div>
