---
import ThemeToggle from "../ThemeToggle.astro";
import DownloadButton from "../DownloadButton.astro";
import Surface from "../ui/Surface.astro";
import LogoMark from "../ui/LogoMark.astro";
import LucideIcon from "../LucideIcon.astro";
import { navIcons } from "../../lib/icons/registry";

interface Props {
  currentPage?: string;
}

const { currentPage = "" } = Astro.props;

const links = [
  { href: "/features", label: "Features", key: "features", icon: navIcons.features },
  { href: "/pricing", label: "Pricing", key: "pricing", icon: navIcons.pricing },
  { href: "/blog", label: "Blog", key: "blog", icon: navIcons.blog },
  { href: "/changelog", label: "Changelog", key: "changelog", icon: navIcons.changelog },
];
---

<header class="hidden md:block fixed top-0 left-0 right-0 z-50 px-4 pt-[max(0.75rem,env(safe-area-inset-top))]">
  <div class="mx-auto max-w-[1160px]">
    <Surface variant="glass" radius="pill" class="overflow-visible shadow-[var(--shadow-nav)]">
      <div
        class="grid w-full min-h-[52px] grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-4 pl-4 pr-2.5"
      >
        <a
          href="/"
          class="relative z-20 flex min-w-0 items-center gap-2.5 justify-self-start group outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring-focus)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface-base)] rounded-[12px]"
        >
          <LogoMark
            size="sm"
            class="transition-transform duration-300 ease-out group-hover:scale-[1.04]"
          />
          <span class="font-display font-semibold text-[14px] tracking-[-0.02em] ink-primary truncate" translate="no">
            Cardmaniacs
          </span>
        </a>

        <nav aria-label="Primary" class="flex items-center justify-center gap-0.5 justify-self-center">
          {links.map((link) => (
            <a
              href={link.href}
              aria-current={currentPage === link.key ? "page" : undefined}
              class:list={[
                "relative inline-flex items-center gap-1.5 px-3 py-1.5 text-[14px] font-display font-medium tracking-[-0.005em] transition-colors duration-200 [border-radius:var(--radius-pill)]",
                currentPage === link.key
                  ? "ink-primary bg-[var(--cm-blue-subtle)]"
                  : "ink-secondary hover:ink-primary hover:bg-[color-mix(in_oklab,var(--surface-overlay)_55%,transparent)]",
              ]}
            >
              <LucideIcon name={link.icon} size={14} class="shrink-0 opacity-85" />
              {link.label}
            </a>
          ))}
        </nav>

        <div class="flex shrink-0 items-center gap-2 justify-self-end">
          <ThemeToggle />
          <DownloadButton size="sm" />
        </div>
      </div>
    </Surface>
  </div>
</header>
