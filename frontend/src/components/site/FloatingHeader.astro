---
import ThemeToggle from "../ThemeToggle.astro";
import Button from "../Button.astro";
import Surface from "../ui/Surface.astro";

interface Props {
  currentPage?: string;
}

const { currentPage = "" } = Astro.props;

const links = [
  { href: "/features", label: "Features", key: "features" },
  { href: "/pricing", label: "Pricing", key: "pricing" },
  { href: "/blog", label: "Blog", key: "blog" },
  { href: "/changelog", label: "Changelog", key: "changelog" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 px-3 pt-3 md:px-4">
  <div class="mx-auto max-w-[1160px]">
    <Surface
      variant="glass"
      radius="pill"
      class="h-[52px] flex items-center justify-between px-3.5 md:px-4 shadow-[var(--shadow-nav)]"
    >
      <a href="/" class="flex items-center gap-2.5 shrink-0">
        <img
          src="/images/Graphic.png"
          alt="Cardmaniacs"
          class="size-7 rounded-[10px] shadow-[var(--shadow-soft)] ring-1 ring-black/5 dark:ring-white/10"
          width="28"
          height="28"
          loading="eager"
        />
        <span class="font-display font-semibold text-[14px] tracking-[-0.02em] ink-primary">
          Cardmaniacs
        </span>
      </a>

      <div class="hidden md:flex items-center gap-1 p-1 [border-radius:var(--radius-pill)] bg-[color-mix(in_oklab,var(--surface-overlay)_55%,transparent)] ring-1 ring-black/5 dark:ring-white/10">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "relative px-3.5 py-2 text-[13px] font-display font-semibold transition-all duration-200 [border-radius:var(--radius-pill)]",
              currentPage === link.key
                ? "ink-primary bg-[var(--cm-blue-subtle-2)] shadow-[var(--shadow-soft)]"
                : "ink-secondary hover:ink-primary hover:bg-[color-mix(in_oklab,var(--surface-overlay)_60%,transparent)]",
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <ThemeToggle />
        <Button href="#download" size="sm" class="hidden sm:inline-flex">
          Download
        </Button>

        <button
          id="cm-mobile-menu-btn"
          type="button"
          class="md:hidden size-9 flex items-center justify-center [border-radius:var(--radius-pill)] ink-tertiary hover:ink-primary hover:bg-[var(--cm-blue-subtle)] transition-all duration-200"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 9h16M4 15h16" />
          </svg>
        </button>
      </div>
    </Surface>

    <Surface
      id="cm-mobile-menu"
      variant="glass"
      radius="panel"
      class="hidden md:hidden mt-2 p-2.5 shadow-[var(--shadow-elevated)]"
    >
      <div class="space-y-1">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "block px-4 py-3 text-[15px] font-display font-semibold transition-colors duration-200 [border-radius:var(--radius-card)]",
              currentPage === link.key
                ? "ink-primary bg-[var(--cm-blue-subtle-2)]"
                : "ink-secondary hover:ink-primary hover:bg-[color-mix(in_oklab,var(--surface-overlay)_70%,transparent)]",
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
      <div class="mt-2 px-1">
        <Button href="#download" size="md" class="w-full justify-center">
          Download
        </Button>
      </div>
    </Surface>
  </div>
</header>

<script>
  function initFloatingHeaderMenu() {
    const btn = document.getElementById("cm-mobile-menu-btn");
    const menu = document.getElementById("cm-mobile-menu");
    if (!(btn instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

    btn.addEventListener("click", () => {
      const isOpen = !menu.classList.contains("hidden");
      menu.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", String(!isOpen));
    });
  }

  initFloatingHeaderMenu();
  document.addEventListener("astro:after-swap", initFloatingHeaderMenu);
</script>

