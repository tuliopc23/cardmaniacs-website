---
import BejamasCard from "../ui/bejamas/Card.astro";
import BejamasButton from "../ui/bejamas/Button.astro";
import Pill from "../Pill.astro";
import PhosphorIcon from "../PhosphorIcon.astro";

interface Props {
  label: string;
  price: string;
  interval: string;
  description: string;
  ctaHref: string;
  ctaLabel?: string;
  highlighted?: boolean;
  badge?: string;
  features?: string[];
  class?: string;
}

const {
  label,
  price,
  interval,
  description,
  ctaHref,
  ctaLabel = "Get started",
  highlighted = false,
  badge,
  features = [],
  class: className = "",
} = Astro.props;
---

<BejamasCard
  padding="none"
  hover={false}
  class:list={[
    "flex flex-col h-full p-6 md:p-7 flex-1",
    highlighted ? "ring-1 ring-[var(--border-accent)] shadow-[var(--shadow-float)]" : "",
    className,
  ]}
>
  {highlighted ? (
    <div class="pointer-events-none absolute inset-0 opacity-80 [background:radial-gradient(900px_420px_at_20%_0%,color-mix(in_oklab,var(--cm-blue)_18%,transparent)_0%,transparent_60%)]"></div>
  ) : null}

  <div class="relative flex flex-col flex-1">
    <div class="flex items-start justify-between gap-4 mb-5">
      <div>
        <p class="editorial-eyebrow editorial-eyebrow-accent mb-2">{label}</p>
        <div class="flex items-baseline gap-1.5">
          <span class="type-section-title ink-primary !text-[clamp(1.75rem,3vw,2.25rem)]">{price}</span>
          <span class="body-s ink-tertiary">{interval}</span>
        </div>
      </div>

      {badge && (
        <Pill variant="accent" class="shrink-0">
          {badge}
        </Pill>
      )}
    </div>

    <p class="body-s ink-secondary mb-5 text-pretty">{description}</p>

    {
      features.length > 0 && (
        <ul class="mb-6 space-y-2.5 flex-1">
          {features.map((line) => (
            <li class="flex gap-2.5 body-s ink-secondary">
              <span class="mt-0.5 shrink-0 text-[var(--accent)]" aria-hidden="true">
                <PhosphorIcon name="check" size={16} />
              </span>
              <span>{line}</span>
            </li>
          ))}
        </ul>
      )
    }

    <BejamasButton href={ctaHref} variant="primary" class="w-full justify-center mt-auto">
      {ctaLabel}
    </BejamasButton>
  </div>
</BejamasCard>
