---
import BejamasCard from "../ui/bejamas/Card.astro";
import AppStoreButton from "../AppStoreButton.astro";
import Pill from "../Pill.astro";
import LucideIcon from "../LucideIcon.astro";
import IconWell from "../ui/IconWell.astro";
import { pricingLabelIcons, type IconKey } from "../../lib/icons/registry";

interface Props {
  label: string;
  price: string;
  interval: string;
  description: string;
  highlighted?: boolean;
  badge?: string;
  features?: string[];
  layout?: "default" | "tall" | "compact";
  class?: string;
}

const {
  label,
  price,
  interval,
  description,
  highlighted = false,
  badge,
  features = [],
  layout = "default",
  class: className = "",
} = Astro.props;

const labelKey = label.trim().toLowerCase();
const labelIcon: IconKey =
  labelKey.includes("trial")
    ? pricingLabelIcons["7-day trial"]
    : labelKey.includes("annual")
      ? pricingLabelIcons.annual
      : pricingLabelIcons.monthly;
---

<BejamasCard
  padding="none"
  hover={false}
  class:list={[
    "flex flex-col h-full flex-1 w-full max-w-[380px] mx-auto",
    layout === "tall" ? "p-6 md:p-7 lg:p-8" : layout === "compact" ? "p-6 lg:p-6" : "p-6 md:p-7",
    highlighted ? "ring-1 ring-[var(--border-accent)] shadow-[var(--shadow-float)]" : "",
    className,
  ]}
>
  <div class="relative flex flex-col flex-1">
    <div class="flex items-start gap-3 mb-5">
      <IconWell icon={labelIcon} size="md" class="mt-0.5" />
      <div class="min-w-0 flex-1">
        <p class:list={["type-card-eyebrow mb-2", highlighted && "type-card-eyebrow-accent"]}>{label}</p>
        <div class="flex items-baseline gap-1.5 flex-wrap tabular-nums">
          <span
            class:list={[
              "type-section-title ink-primary",
              layout === "tall"
                ? "!text-[clamp(2rem,3.2vw,2.75rem)]"
                : "!text-[clamp(1.75rem,3vw,2.25rem)]",
            ]}
          >
            {price}
          </span>
          <span class="type-card-meta">{interval}</span>
        </div>
      </div>

      {badge && (
        <Pill variant="accent" class="shrink-0 gap-1">
          <LucideIcon name="sparkles" size={11} aria-hidden="true" />
          {badge}
        </Pill>
      )}
    </div>

    <p class="body-s ink-secondary mb-5 text-pretty">{description}</p>

    {
      features.length > 0 && (
        <ul class="mb-6 space-y-2.5">
          {features.map((line) => (
            <li class="flex gap-2.5 type-card-meta items-start">
              <span class="mt-0.5 shrink-0 text-[var(--accent)]" aria-hidden="true">
                <LucideIcon name="check" size={15} strokeWidth={2.5} />
              </span>
              <span class="text-[var(--ink-secondary)]">{line}</span>
            </li>
          ))}
        </ul>
      )
    }

    <AppStoreButton fullWidth class="mt-auto" />
  </div>
</BejamasCard>
