---
import Container from "../Container.astro";
import AppStoreButton from "../AppStoreButton.astro";
import MarketingPlatformShowcase from "../marketing/MarketingPlatformShowcase.astro";
import LucideIcon from "../LucideIcon.astro";
import EyebrowLabel from "../ui/EyebrowLabel.astro";
import LogoMark from "../ui/LogoMark.astro";
import { heroChipIcons } from "../../lib/icons/registry";

const chips = ["Feeds", "Read Later", "Bookmarks", "Highlights", "Summaries", "Offline"] as const;
---

<section class="relative left-1/2 right-1/2 w-screen -translate-x-1/2 overflow-x-clip pb-14 md:pb-22">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[min(72vh,820px)] -z-10"
    aria-hidden="true"
  >
    <div
      class="absolute inset-0 bg-[radial-gradient(900px_520px_at_50%_-10%,var(--accent-atmo-hero-spot)_0%,transparent_55%),radial-gradient(760px_420px_at_12%_30%,color-mix(in_oklab,var(--bg-accent-atmo-1)_32%,transparent)_0%,transparent_60%),radial-gradient(700px_400px_at_88%_25%,color-mix(in_oklab,var(--bg-accent-atmo-2)_24%,transparent)_0%,transparent_58%),linear-gradient(180deg,color-mix(in_oklab,var(--surface-overlay)_40%,transparent),transparent_72%)]"
    />
  </div>

  <Container class="relative z-10 pt-16 md:pt-40">
    <div data-device-hero class="flex flex-col items-center">
      <div class="w-full max-w-[620px] mx-auto mb-10 md:mb-12">
        <EyebrowLabel icon="library" class="mb-4">A calmer home for everything you read</EyebrowLabel>

        <div class="flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-6 mb-7">
          <LogoMark size="lg" class="shrink-0" />
          <h1 class="display-hero ink-primary text-balance flex-1 min-w-0">
            Your native reading desk —<br class="hidden sm:block" />
            collected, triaged, finished.
          </h1>
        </div>

        <p class="type-lede measure mb-9">
          Cardmaniacs unifies feeds, read-later, bookmarks, and highlights into one quiet Apple-native command
          center — so you stop tab-hoarding and start reading.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
          <AppStoreButton />
          <a
            href="/features"
            class="inline-flex items-center gap-2 font-display font-semibold text-[15px] ink-primary py-3 group"
          >
            Explore features
            <span
              class="inline-flex items-center justify-center size-6 [border-radius:var(--radius-pill)] bg-[var(--cm-blue-subtle)] text-[var(--cm-blue-ink)] transition-transform duration-200 group-hover:translate-x-0.5"
              aria-hidden="true"
            >
              <LucideIcon name="compass" size={16} class="translate-x-px" />
            </span>
          </a>
        </div>

        <p class="sr-only">Including {chips.join(", ")}.</p>
        <div
          class="hero-chip-rail mb-2 flex w-full flex-wrap justify-start gap-0.5 p-1 rounded-[var(--radius-pill)] border border-[var(--border-subtle)] bg-[color-mix(in_oklab,var(--surface-glass)_55%,transparent)] shadow-[var(--shadow-pill)] backdrop-blur-md backdrop-saturate-[var(--sat-glass)] supports-[backdrop-filter]:bg-[color-mix(in_oklab,var(--surface-glass)_42%,transparent)] md:mb-0"
          aria-hidden="true"
        >
          {
            chips.map((c, i) => (
              <span
                class:list={[
                  "hero-chip-pill inline-flex items-center gap-1.5 select-none rounded-[var(--radius-pill)] px-3 py-1.5 text-[11px] font-display font-semibold tracking-wide text-[var(--ink-secondary)]",
                  i === 0 && "hero-chip-pill--active",
                ]}
              >
                <LucideIcon name={heroChipIcons[c]} size={12} class="opacity-90" />
                {c}
              </span>
            ))
          }
        </div>
      </div>

      <div class="w-full max-w-[920px] mx-auto" data-reveal>
        <MarketingPlatformShowcase
          macAlt="Cardmaniacs on macOS — card-based reading interface"
          iphoneAlt="Cardmaniacs on iPhone — reading queue"
          ipadAlt="Cardmaniacs on iPad — workspace"
        />
      </div>
    </div>
  </Container>
</section>

<style>
  .hero-chip-pill--active {
    background: var(--cm-blue-subtle);
    color: var(--cm-blue-ink);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  :global([data-theme="dark"]) .hero-chip-pill--active {
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
</style>
