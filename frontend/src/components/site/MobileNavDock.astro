---
import Surface from "../ui/Surface.astro";
import LucideIcon from "../LucideIcon.astro";
import AppStoreDockButton from "../AppStoreDockButton.astro";
import LogoMark from "../ui/LogoMark.astro";
import MobileDrawerLink from "./MobileDrawerLink.astro";
import ThemeDockButton from "../ThemeDockButton.astro";
import {
  exploreNavLinks,
  elsewhereNavLinks,
  getPageLabel,
  isActiveNavLink,
} from "../../lib/site-nav";

interface Props {
  currentPage?: string;
}

const { currentPage = "" } = Astro.props;

const currentLabel = getPageLabel(currentPage);

const sectionInsetClass =
  "rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[color-mix(in_oklab,var(--surface-glass)_55%,transparent)] p-1.5 shadow-[var(--shadow-soft)] backdrop-blur-[calc(var(--blur-glass)*0.5)] backdrop-saturate-[var(--sat-glass)]";
---

<nav class="lg:hidden" aria-label="Mobile navigation">
  <div
    id="cm-mobile-drawer-backdrop"
    class="cm-mobile-drawer-backdrop fixed inset-0 z-[54] bg-[color-mix(in_oklab,var(--ink-primary)_26%,transparent)] opacity-0 pointer-events-none backdrop-blur-[var(--blur-glass)] backdrop-saturate-[var(--sat-glass)] motion-reduce:transition-none [&[data-open=true]]:opacity-100 [&[data-open=true]]:pointer-events-auto"
    data-open="false"
    aria-hidden="true"
  />

  <div
    id="cm-mobile-drawer"
    class="cm-mobile-drawer fixed inset-x-0 bottom-0 top-[12vh] z-[55] flex flex-col rounded-t-[var(--radius-hero)] border border-b-0 border-[var(--border-glass)] bg-[var(--surface-glass)] opacity-0 pointer-events-none shadow-[var(--shadow-glass)] backdrop-blur-[var(--blur-glass)] backdrop-saturate-[var(--sat-glass)] motion-reduce:transition-none motion-reduce:opacity-100 [&[data-open=true]]:opacity-100 [&[data-open=true]]:pointer-events-auto"
    data-open="false"
    inert
    role="dialog"
    aria-modal="true"
    aria-label="Site menu"
    style="transform: translateY(100%)"
  >
    <div class="flex items-center gap-3 px-5 pb-3 pt-4">
      <LogoMark size="sm" class="shrink-0" />
      <div class="min-w-0 flex-1">
        <p class="font-display font-semibold text-[15px] tracking-[-0.02em] ink-primary">Menu</p>
        <p class="body-s ink-tertiary truncate">{currentLabel}</p>
      </div>
    </div>

    <div class="flex-1 overflow-y-auto px-4 pb-[max(6.5rem,env(safe-area-inset-bottom))]">
      <div id="cm-drawer-section-explore" class="mb-4" data-drawer-section>
        <div class:list={[sectionInsetClass, "flex flex-col gap-0.5"]}>
          {
            exploreNavLinks.map((link) => (
              <MobileDrawerLink
                href={link.href}
                label={link.label}
                icon={link.icon}
                active={isActiveNavLink(link.key, currentPage)}
              />
            ))
          }
        </div>
      </div>

      <div id="cm-drawer-section-elsewhere" class="mb-4" data-drawer-section>
        <div class:list={[sectionInsetClass, "flex flex-col gap-0.5"]}>
          {
            elsewhereNavLinks.map((link) => (
              <MobileDrawerLink
                href={link.href}
                label={link.label}
                icon={link.icon}
                active={isActiveNavLink(link.key, currentPage)}
                external={link.external}
              />
            ))
          }
        </div>
      </div>

      <div id="cm-drawer-section-jump" data-drawer-section>
        <label class="sr-only" for="cm-mobile-drawer-jump">Jump to a page</label>
        <input
          id="cm-mobile-drawer-jump"
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder="Jump to a page…"
          class="cm-drawer-jump-input w-full rounded-[var(--radius-card)] border border-[var(--border-glass)] bg-[color-mix(in_oklab,var(--surface-inset)_55%,transparent)] px-4 py-3 font-display text-[15px] ink-primary shadow-[inset_0_1px_2px_color-mix(in_oklab,var(--ink-primary)_6%,transparent)] placeholder:ink-tertiary outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring-focus)]"
        />
        <p id="cm-drawer-jump-empty" class="body-s ink-tertiary mt-2 px-1 hidden" role="status">No pages match that search.</p>
      </div>
    </div>
  </div>

  <div
    class="cm-mobile-dock fixed inset-x-0 bottom-0 z-50 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-2 pointer-events-none before:pointer-events-none before:absolute before:inset-x-4 before:top-0 before:h-px before:bg-[var(--ambient-glint-line)]"
  >
    <div class="mx-auto flex max-w-[580px] items-center gap-2 pointer-events-auto">
      <Surface variant="glass" radius="pill" class="min-w-0 flex-1 shadow-[var(--shadow-nav)]">
        <button
          id="cm-mobile-dock-menu-btn"
          type="button"
          class="relative flex w-full min-h-[52px] items-center gap-2.5 px-3.5 py-2.5 font-display text-[15px] font-semibold tracking-[-0.02em] ink-primary outline-none focus-visible:ring-2 focus-visible:ring-[var(--ring-focus)] focus-visible:ring-inset active:scale-[0.99] transition-transform duration-200 motion-reduce:transition-none"
          aria-expanded="false"
          aria-controls="cm-mobile-drawer"
          aria-label="Open site menu"
        >
          <LogoMark size="sm" class="shrink-0" />
          <span class="relative flex size-5 shrink-0 items-center justify-center">
            <span
              data-dock-icon="menu"
              class="absolute inset-0 flex items-center justify-center transition-[opacity,transform] duration-200 motion-reduce:transition-none"
            >
              <LucideIcon name="menu" size={18} class="ink-secondary" />
            </span>
            <span
              data-dock-icon="close"
              class="absolute inset-0 flex items-center justify-center opacity-0 scale-75 transition-[opacity,transform] duration-200 motion-reduce:transition-none pointer-events-none"
            >
              <LucideIcon name="x" size={18} class="ink-secondary" />
            </span>
          </span>
          <span class="min-w-0 truncate">{currentLabel}</span>
        </button>
      </Surface>
      <AppStoreDockButton />
      <ThemeDockButton />
    </div>
  </div>
</nav>

<script>
  import { animateEl } from "../../lib/motion/animate-el";

  function initMobileNavDock() {
    window.__cmDockAbort?.abort();
    const ac = new AbortController();
    window.__cmDockAbort = ac;
    const { signal } = ac;

    const menuBtn = document.getElementById("cm-mobile-dock-menu-btn");
    const drawer = document.getElementById("cm-mobile-drawer");
    const backdrop = document.getElementById("cm-mobile-drawer-backdrop");
    const jumpInput = document.getElementById("cm-mobile-drawer-jump");
    const jumpEmpty = document.getElementById("cm-drawer-jump-empty");

    if (
      !(menuBtn instanceof HTMLButtonElement) ||
      !(drawer instanceof HTMLElement) ||
      !(backdrop instanceof HTMLElement)
    )
      return;

    const iconMenu = menuBtn.querySelector<HTMLElement>('[data-dock-icon="menu"]');
    const iconClose = menuBtn.querySelector<HTMLElement>('[data-dock-icon="close"]');
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const focusableSelector =
      'a[href]:not([disabled]), button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';

    const getFocusable = () => [...drawer.querySelectorAll<HTMLElement>(focusableSelector)];

    const syncDockIcons = (open: boolean) => {
      if (iconMenu && iconClose) {
        iconMenu.classList.toggle("opacity-0", open);
        iconMenu.classList.toggle("scale-75", open);
        iconClose.classList.toggle("opacity-0", !open);
        iconClose.classList.toggle("scale-75", !open);
        iconClose.classList.toggle("pointer-events-none", !open);
      }
    };

    const updateSectionVisibility = () => {
      drawer.querySelectorAll<HTMLElement>("[data-drawer-section]").forEach((section) => {
        const links = section.querySelectorAll<HTMLElement>("[data-drawer-link]");
        const visible = [...links].some((link) => !link.classList.contains("hidden"));
        const isJump = section.id === "cm-drawer-section-jump";
        section.classList.toggle("hidden", !visible && !isJump);
      });

      if (jumpEmpty instanceof HTMLElement && jumpInput instanceof HTMLInputElement) {
        const q = jumpInput.value.trim();
        const anyVisible = [...drawer.querySelectorAll<HTMLElement>("[data-drawer-link]")].some(
          (link) => !link.classList.contains("hidden")
        );
        jumpEmpty.classList.toggle("hidden", q.length === 0 || anyVisible);
      }
    };

    const setOpen = (open: boolean) => {
      drawer.dataset.open = String(open);
      backdrop.dataset.open = String(open);
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? "Close site menu" : "Open site menu");
      drawer.toggleAttribute("inert", !open);
      document.documentElement.classList.toggle("cm-drawer-open", open);
      syncDockIcons(open);

      if (reducedMotion) {
        drawer.style.transform = open ? "translateY(0)" : "translateY(100%)";
        backdrop.style.opacity = open ? "1" : "0";
      } else if (open) {
        animateEl(backdrop, { opacity: [0, 1] }, { duration: 0.24, easing: "ease-out" });
        animateEl(
          drawer,
          { transform: ["translateY(100%)", "translateY(0)"] },
          { duration: 0.42, easing: [0.22, 1, 0.36, 1] }
        );
      } else {
        animateEl(backdrop, { opacity: [1, 0] }, { duration: 0.2, easing: "ease-in" });
        animateEl(
          drawer,
          { transform: ["translateY(0)", "translateY(100%)"] },
          { duration: 0.3, easing: [0.4, 0, 1, 1] }
        );
      }

      if (open) {
        queueMicrotask(() => {
          const first = getFocusable()[0];
          first?.focus();
        });
      } else {
        menuBtn.focus();
        if (jumpInput instanceof HTMLInputElement) jumpInput.value = "";
        drawer.querySelectorAll<HTMLElement>("[data-drawer-link]").forEach((el) => {
          el.classList.remove("hidden");
        });
        drawer.querySelectorAll<HTMLElement>("[data-drawer-section]").forEach((el) => {
          el.classList.remove("hidden");
        });
        if (jumpEmpty) jumpEmpty.classList.add("hidden");
      }
    };

    const isOpen = () => drawer.dataset.open === "true";

    menuBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(!isOpen());
    }, { signal });

    backdrop.addEventListener("click", () => setOpen(false), { signal });

    drawer.addEventListener("keydown", (e) => {
      if (!isOpen()) return;
      if (e.key === "Escape") {
        e.preventDefault();
        setOpen(false);
        return;
      }
      if (e.key !== "Tab") return;
      const nodes = getFocusable();
      if (nodes.length === 0) return;
      const first = nodes[0]!;
      const last = nodes.at(-1)!;
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }, { signal });

    drawer.querySelectorAll("a[data-drawer-link]").forEach((a) => {
      a.addEventListener("click", () => setOpen(false), { signal });
    });

    if (jumpInput instanceof HTMLInputElement) {
      jumpInput.addEventListener("input", () => {
        const q = jumpInput.value.trim().toLowerCase();
        drawer.querySelectorAll<HTMLElement>("[data-drawer-link]").forEach((link) => {
          const text = link.textContent?.trim().toLowerCase() ?? "";
          link.classList.toggle("hidden", q.length > 0 && !text.includes(q));
        });
        updateSectionVisibility();
      }, { signal });
    }

    const mq = window.matchMedia("(min-width: 1024px)");
    const onMqChange = () => {
      if (mq.matches && isOpen()) setOpen(false);
    };
    mq.addEventListener("change", onMqChange, { signal });
  }

  initMobileNavDock();
  document.addEventListener("astro:after-swap", initMobileNavDock);
</script>
