---
import Surface from "../ui/Surface.astro";
import Pill from "../Pill.astro";
import Prose from "../ui/Prose.astro";

interface Props {
  version?: string;
  type?: string;
  platform?: string;
  date?: string;
  title: string;
}

const { version, type, platform, date, title } = Astro.props;

const typeVariant =
  type === "feature" ? "accent" : type === "fix" ? "muted" : "default";

const formattedDate =
  date &&
  new Date(date).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
---

<div
  class="grid gap-6 md:grid-cols-[minmax(0,6.75rem)_1fr] md:gap-8 lg:grid-cols-[minmax(0,8rem)_1fr]"
>
  <div
    class="flex flex-col gap-3 border-b border-[var(--border-subtle)] pb-5 md:border-b-0 md:border-r md:pb-0 md:pr-6 lg:pr-8"
  >
    <div class="flex flex-wrap gap-2">
      {version && <Pill variant="accent">v{version}</Pill>}
      {type && <Pill variant={typeVariant}>{type}</Pill>}
      {platform && platform !== "all" && <Pill variant="muted">{platform}</Pill>}
    </div>
    {
      formattedDate && date && (
        <time class="caption ink-tertiary mt-auto pt-1 md:pt-4 md:border-t md:border-[var(--border-subtle)]" datetime={date}>
          {formattedDate}
        </time>
      )
    }
  </div>

  <Surface variant="elevated" radius="card" class="p-6 md:p-8 marketing-reader-chrome">
    <h2 class="heading ink-primary mb-5 text-balance">{title}</h2>
    <div class="marketing-reader-prose">
      <Prose size="sm">
        <slot />
      </Prose>
    </div>
  </Surface>
</div>
