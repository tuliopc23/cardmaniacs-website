---
import ThemeToggle from './ThemeToggle.astro';
import Button from './Button.astro';

interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;

const links = [
  { href: '/features', label: 'Features', key: 'features' },
  { href: '/pricing', label: 'Pricing', key: 'pricing' },
  { href: '/blog', label: 'Blog', key: 'blog' },
  { href: '/changelog', label: 'Changelog', key: 'changelog' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 pt-3 px-4">
  <nav
    class="mx-auto max-w-[1120px] flex items-center justify-between h-12 px-4 rounded-[var(--radius-full)] surface-floating border border-[var(--border-subtle)]"
    style={`box-shadow: var(--shadow-nav);`}
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group shrink-0">
      <img
        src="/images/Graphic.png"
        alt="Cardmaniacs"
        class="w-6 h-6 rounded-[6px]"
        width="24"
        height="24"
      />
      <span class="font-display font-semibold text-[14px] tracking-[-0.02em] ink-primary group-hover:ink-accent transition-colors duration-200">
        Cardmaniacs
      </span>
    </a>

    <!-- Center links — desktop only -->
    <div class="hidden md:flex items-center gap-0.5">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-[13px] font-display font-medium px-3 py-1.5 rounded-[var(--radius-full)] transition-all duration-200',
            currentPage === link.key
              ? 'ink-primary bg-[var(--accent-subtle)]'
              : 'ink-secondary hover:ink-primary hover:bg-[var(--surface-overlay)]',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Right side -->
    <div class="flex items-center gap-2">
      <ThemeToggle />
      <Button href="#download" size="sm" class="hidden sm:inline-flex">
        Download
      </Button>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden w-8 h-8 flex items-center justify-center rounded-[var(--radius-full)] ink-tertiary hover:ink-primary transition-colors"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden mt-2 mx-auto max-w-[1120px] rounded-[var(--radius-lg)] surface-floating border border-[var(--border-subtle)] p-3 space-y-1"
    style={`box-shadow: var(--shadow-elevated);`}
  >
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'block text-[15px] font-display font-medium px-4 py-2.5 rounded-[var(--radius-md)] transition-all duration-200',
          currentPage === link.key
            ? 'ink-primary bg-[var(--accent-subtle)]'
            : 'ink-secondary hover:ink-primary hover:bg-[var(--surface-overlay)]',
        ]}
      >
        {link.label}
      </a>
    ))}
    <div class="pt-2 px-4">
      <Button href="#download" size="md" class="w-full justify-center">
        Download
      </Button>
    </div>
  </div>
</header>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
