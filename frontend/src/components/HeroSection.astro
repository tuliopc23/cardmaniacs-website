---
import Container from './Container.astro';
import AppStoreButton from './AppStoreButton.astro';
---

<section class="relative pt-32 pb-12 md:pt-40 md:pb-20 overflow-hidden">
  <!-- Single subtle radial glow — the only ambient effect on the entire page -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] rounded-full pointer-events-none opacity-[0.07]"
    style="background: radial-gradient(ellipse at center, var(--accent) 0%, transparent 70%);"
  ></div>

  <Container class="relative z-10">
    <!-- Text block -->
    <div class="max-w-[680px] mb-16 md:mb-20">
      <p class="caption ink-accent mb-5">Feeds · Read Later · Bookmarks</p>

      <h1 class="display-xl ink-primary mb-6">
        Your reading desk,<br/>beautifully unified.
      </h1>

      <p class="body-l ink-secondary max-w-[520px] mb-10 leading-relaxed">
        A native Apple app that brings RSS feeds, Read Later, and Bookmarks together in one calm, card-based experience. Built for people who collect, save, and actually finish what they read.
      </p>

      <div class="flex flex-col sm:flex-row items-start gap-4">
        <AppStoreButton />
        <a
          href="/features"
          class="inline-flex items-center gap-1.5 font-display font-medium text-[15px] ink-accent py-3 group"
        >
          Explore features
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Hero screenshot — theme-aware Mac bezel -->
    <div data-reveal class="max-w-[960px] mx-auto">
      <img
        src="/images/cardmaniacs-mac-bezel-light.png"
        alt="Cardmaniacs on macOS — card-based reading interface"
        loading="eager"
        class="hero-screenshot hero-screenshot--light w-full h-auto rounded-[var(--radius-xl)] shadow-[var(--shadow-device)]"
      />
      <img
        src="/images/cardmaniacs-mac-bezel-dark.png"
        alt="Cardmaniacs on macOS — card-based reading interface (dark mode)"
        loading="eager"
        class="hero-screenshot hero-screenshot--dark w-full h-auto rounded-[var(--radius-xl)] shadow-[var(--shadow-device)]"
      />
    </div>
  </Container>
</section>

<style>
  /* Show light bezel in light mode, dark bezel in dark mode */
  [data-theme="light"] .hero-screenshot--dark { display: none; }
  [data-theme="light"] .hero-screenshot--light { display: block; }
  [data-theme="dark"] .hero-screenshot--light { display: none; }
  [data-theme="dark"] .hero-screenshot--dark { display: block; }
</style>
