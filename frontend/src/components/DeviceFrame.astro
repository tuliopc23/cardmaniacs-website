---
import Surface from './ui/Surface.astro';

interface Props {
  src: string;
  alt: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { src, alt, loading = 'lazy', class: className = '' } = Astro.props;
---

<Surface
  variant="elevated"
  class:list={[
    'overflow-hidden [border-radius:var(--radius-hero)] shadow-[var(--shadow-device)] transition-shadow duration-500',
    'hover:shadow-[var(--shadow-device)] hover:ring-1 hover:ring-[var(--border-subtle)]',
    className,
  ]}
>
  <div class="h-9 flex items-center px-4 bg-[var(--surface-overlay)] border-b border-[var(--border-subtle)]">
    <div class="flex items-center gap-[7px]">
      <span class="size-[11px] rounded-full bg-[var(--mac-dot-close)]"></span>
      <span class="size-[11px] rounded-full bg-[var(--mac-dot-minimize)]"></span>
      <span class="size-[11px] rounded-full bg-[var(--mac-dot-zoom)]"></span>
    </div>
  </div>

  <img src={src} alt={alt} loading={loading} class="block w-full h-auto" />
</Surface>
