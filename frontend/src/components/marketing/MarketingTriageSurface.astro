---
import Surface from "../ui/Surface.astro";
import Pill from "../Pill.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const cards = [
  { title: "The calm web reader returns", source: "RSS · Daring Fireball", state: "Unread" },
  { title: "Swift concurrency in practice", source: "GitHub README", state: "Saved" },
  { title: "Why feeds still win", source: "Article", state: "Unread" },
];
---

<Surface variant="elevated" radius="panel" class:list={["p-4 md:p-5", className]}>
  <div class="flex flex-col gap-2">
    {
      cards.map((card, i) => (
        <div
          class:list={[
            "flex items-start justify-between gap-3 rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[color-mix(in_oklab,var(--surface-overlay)_40%,transparent)] p-3 md:p-4 transition-shadow",
            i === 0 && "shadow-[var(--shadow-soft)] ring-1 ring-[var(--border-accent)]",
          ]}
        >
          <div class="min-w-0">
            <p class="font-display text-[14px] font-semibold tracking-[-0.02em] ink-primary leading-snug mb-1">
              {card.title}
            </p>
            <p class="body-s ink-tertiary">{card.source}</p>
          </div>
          <Pill variant={card.state === "Unread" ? "accent" : "muted"}>{card.state}</Pill>
        </div>
      ))
    }
  </div>
  <p class="caption ink-tertiary mt-4 text-center">Keyboard-first triage · j/k to move · enter to read</p>
</Surface>
