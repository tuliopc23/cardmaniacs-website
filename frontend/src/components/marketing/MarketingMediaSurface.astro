---
import Surface from "../ui/Surface.astro";
import IconWell from "../ui/IconWell.astro";
import LucideIcon from "../LucideIcon.astro";
import EyebrowLabel from "../ui/EyebrowLabel.astro";

interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  title = "Watch & listen without browser chaos",
  subtitle = "YouTube and podcasts inside a calm native player.",
  class: className = "",
} = Astro.props;
---

<Surface variant="elevated" radius="panel" class:list={["p-6 md:p-8", className]}>
  <EyebrowLabel icon="youtube" class="mb-4">Media channels</EyebrowLabel>
  <div class="flex items-start gap-4">
    <IconWell icon="broadcast" size="lg" />
    <div>
      <p class="type-card-title mb-1">{title}</p>
      <p class="type-card-meta text-[var(--ink-secondary)]">{subtitle}</p>
    </div>
  </div>
  <div
    class="mt-6 aspect-video w-full rounded-[var(--radius-card)] bg-[color-mix(in_oklab,var(--surface-inset)_80%,transparent)] border border-[var(--border-subtle)] flex items-center justify-center gap-3"
    aria-hidden="true"
  >
    <LucideIcon name="youtube" size={36} class="ink-tertiary opacity-70" />
    <LucideIcon name="rss" size={32} class="ink-tertiary opacity-50" />
  </div>
</Surface>
