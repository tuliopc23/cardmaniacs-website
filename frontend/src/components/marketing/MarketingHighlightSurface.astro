---
import Surface from "../ui/Surface.astro";
import Pill from "../Pill.astro";

interface Props {
  excerpt: string;
  source?: string;
  tags?: string[];
  class?: string;
}

const { excerpt, source, tags = [], class: className = "" } = Astro.props;
---

<Surface variant="glass" radius="card" class:list={["p-5 md:p-6", className]}>
  <p class="editorial-eyebrow editorial-eyebrow-accent mb-3">Saved highlight</p>
  <blockquote class="font-display text-[1.125rem] md:text-[1.25rem] font-medium leading-snug tracking-[-0.02em] ink-primary text-pretty mb-4">
    <mark class="reader-highlight bg-transparent px-0">{excerpt}</mark>
  </blockquote>
  <div class="flex flex-wrap items-center gap-2">
    {source && <span class="body-s ink-secondary">{source}</span>}
    {tags.map((tag) => (
      <Pill variant="muted">{tag}</Pill>
    ))}
  </div>
  <p class="caption ink-tertiary mt-4">Stored for later reference — revisit when it matters.</p>
</Surface>
