---
import MarketingDeviceComposition from "./MarketingDeviceComposition.astro";
import { marketingImages } from "../../lib/marketing-images";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const mac = {
  label: "Mac",
  aspect: "mac" as const,
  srcLight: marketingImages.macHeroLight,
  srcDark: marketingImages.macHeroDark,
  alt: "Cardmaniacs on macOS",
};

const compact = [
  {
    label: "iPhone",
    aspect: "iphone" as const,
    srcLight: marketingImages.iphoneReader,
    alt: "Cardmaniacs on iPhone",
  },
  {
    label: "iPad",
    aspect: "ipad" as const,
    srcLight: marketingImages.ipadWorkspace,
    alt: "Cardmaniacs on iPad",
  },
];
---

<div
  data-platform-stills
  class:list={[
    "flex flex-col gap-8 md:gap-10 lg:grid lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.55fr)_minmax(0,0.55fr)] lg:items-end lg:gap-8",
    className,
  ]}
>
  <figure data-platform-still class="text-center" style="--stagger-index: 0">
    <MarketingDeviceComposition
      aspect={mac.aspect}
      srcLight={mac.srcLight}
      srcDark={mac.srcDark}
      alt={mac.alt}
      class="mx-auto w-full max-w-[920px] lg:max-w-none"
    />
    <figcaption class="type-card-meta ink-secondary mt-4">{mac.label}</figcaption>
  </figure>

  <div class="grid grid-cols-2 gap-6 sm:gap-8 max-w-[520px] mx-auto w-full lg:contents">
    {
      compact.map((device, i) => (
        <figure
          data-platform-still
          class="text-center"
          style={`--stagger-index: ${i + 1}`}
        >
          <MarketingDeviceComposition
            aspect={device.aspect}
            srcLight={device.srcLight}
            alt={device.alt}
            class:list={[
              "mx-auto w-full",
              device.aspect === "iphone" ? "max-w-[200px] sm:max-w-[220px] lg:max-w-none" : "max-w-[280px] sm:max-w-[320px] lg:max-w-none",
            ]}
          />
          <figcaption class="type-card-meta ink-secondary mt-4">{device.label}</figcaption>
        </figure>
      ))
    }
  </div>
</div>

<style>
  [data-platform-still] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-platform-still] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  function initPlatformStills() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    document.querySelectorAll("[data-platform-stills]").forEach((root) => {
      const htmlRoot = root as HTMLElement;
      if (htmlRoot.dataset.stillsInit) return;
      htmlRoot.dataset.stillsInit = "1";

      const figures = [...htmlRoot.querySelectorAll<HTMLElement>("[data-platform-still]")];
      if (figures.length === 0) return;

      inView(
        htmlRoot,
        () => {
          figures.forEach((el) => {
            el.style.transform = "translateY(18px)";
          });
          animate(
            figures,
            ({ y: [18, 0] } as any),
            ({ duration: 0.5, delay: stagger(0.09), easing: "ease-out" } as any)
          );
        },
        { margin: "-80px 0px -80px 0px" }
      );
    });
  }

  initPlatformStills();
  document.addEventListener("astro:after-swap", initPlatformStills);
</script>
