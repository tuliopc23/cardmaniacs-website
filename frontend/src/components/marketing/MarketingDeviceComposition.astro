---
import ProductFrame from "../site/ProductFrame.astro";

interface Props {
  srcLight: string;
  srcDark: string;
  alt: string;
  aspect?: "mac" | "iphone" | "ipad";
  class?: string;
}

const { srcLight, srcDark, alt, aspect = "mac", class: className = "" } = Astro.props;

const aspectClass = {
  mac: "w-full max-w-[920px]",
  iphone: "w-full max-w-[220px] mx-auto",
  ipad: "w-full max-w-[560px] mx-auto",
}[aspect];
---

<figure class:list={[aspectClass, className]}>
  <ProductFrame srcLight={srcLight} srcDark={srcDark} alt={alt} />
</figure>
