---
import Surface from './ui/Surface.astro';

const { variant = 'raised', class: className = '', as, href } = Astro.props;
---

<Surface
  href={href}
  as={as}
  variant={variant === 'flat' ? 'paper' : 'elevated'}
  interactive={variant === 'interactive'}
  class={className}
>
  <slot />
</Surface>
