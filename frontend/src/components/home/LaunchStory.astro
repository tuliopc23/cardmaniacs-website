---
import Container from "../Container.astro";
import ProductShowcase from "../ProductShowcase.astro";
import { marketingImages } from "../../lib/marketing-images";
import MarketingPlatformStills from "../marketing/MarketingPlatformStills.astro";
import LucideIcon from "../LucideIcon.astro";
import IconWell from "../ui/IconWell.astro";
import PricingSection from "../PricingSection.astro";
import CtaBanner from "../CtaBanner.astro";
import { workflowStepIcons } from "../../lib/icons/registry";

const workflowSteps = [
  { step: "Collect", desc: "Feeds, saves, and imports land in one inbox." },
  { step: "Triage", desc: "Skim, tag, and archive without tab chaos." },
  { step: "Read", desc: "Articles, PDFs, and EPUB in one Reader." },
  { step: "Highlight", desc: "Mark what matters inside the app." },
  { step: "Revisit", desc: "Find saved references when they count." },
];
---

<section class="py-16 md:py-24 section-band">
  <Container>
    <div class="max-w-[680px] mx-auto text-center mb-12">
      <h2 class="type-section-title ink-primary mb-5">Your reading life is scattered.</h2>
      <p class="type-lede measure-tight mx-auto">
        Tabs, RSS, read-later queues, PDFs, videos, podcasts, and highlights live in different apps. Cardmaniacs gives
        them one calm native home.
      </p>
    </div>
  </Container>
</section>

<section class="py-16 md:py-20">
  <Container>
    <div class="max-w-[720px] mx-auto text-center">
      <p class="type-lede measure-tight mx-auto mb-8">
        One loop for everything you save — collect in a single inbox, triage in cards, read in a native Reader,
        highlight what matters, and revisit when the idea becomes useful.
      </p>
      <div class="flex flex-wrap justify-center gap-2">
        {
          workflowSteps.map((item, i) => (
            <span class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-[var(--border-subtle)] bg-[color-mix(in_oklab,var(--surface-elevated)_75%,transparent)] px-3 py-2 shadow-[var(--shadow-soft)]">
              <IconWell icon={workflowStepIcons[i]} size="sm" />
              <span class="type-card-title !text-[0.8125rem]">{item.step}</span>
            </span>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<section class="py-16 md:py-24">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
      <div>
        <h2 class="type-section-title ink-primary mb-5">See the desk in action.</h2>
        <p class="type-lede measure-tight mb-6">
          Feeds, read-later, bookmarks, and highlights share one calm card stream. The app chrome is the proof — explore
          the full feature set when you are ready.
        </p>
        <a
          href="/features"
          class="inline-flex items-center gap-2 font-display font-semibold text-[15px] ink-primary py-2 group"
        >
          Explore all features
          <span
            class="inline-flex items-center justify-center size-6 [border-radius:var(--radius-pill)] bg-[var(--cm-blue-subtle)] text-[var(--cm-blue-ink)] transition-transform duration-200 group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            <LucideIcon name="compass" size={16} class="translate-x-px" />
          </span>
        </a>
      </div>
      <div data-reveal>
        <ProductShowcase
          src={marketingImages.macTriage}
          alt="Cardmaniacs feed triage on Mac — calm card stream"
        />
      </div>
    </div>
  </Container>
</section>

<section class="py-16 md:py-24 section-band">
  <Container>
    <div class="max-w-[680px] mx-auto text-center mb-10">
      <h2 class="type-section-title ink-primary mb-5 text-balance">Mac, iPhone, and iPad — each considered.</h2>
      <p class="type-lede measure-tight mx-auto">
        Keyboard-first on Mac. Touch-first capture on iPhone. Workspace-ready on iPad. Dark and light modes throughout.
      </p>
    </div>
    <div data-reveal>
      <MarketingPlatformStills />
    </div>
  </Container>
</section>

<PricingSection compact />

<CtaBanner />
